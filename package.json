{
  "name": "goatcode",
  "version": "2.1.0",
  "description": "Every provider. One terminal. Agentic coding CLI with MCP, skills and plugins.",
  "module": "src/index.ts",
  "type": "module",
  "bin": { "goat": "./src/index.ts" },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "bun": ">=1.1" },
  "repository": { "type": "git", "url": "git+https://github.com/Arhan-w/GoatCode.git" },
  "keywords": ["cli", "ai", "coding-agent", "agent", "terminal", "mcp", "bun", "llm"],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "compile": "bun build src/index.ts --compile --outfile dist/goat"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "marked": "^18.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "zod": "^4.5.4"
  },
  "bun": {
    "tsconfig": "tsconfig.json"
  }
}
