{"role":"tool","content":"    1\t# Upstream GAIA question_scorer (bug-for-bug: \"3,676\" parses as a 2-element list).\n    2\timport re\n    3\timport string\n    4\t\n    5\t\n    6\tdef normalize_str(input_str, remove_punct=True):\n    7\t    if remove_punct:\n    8\t        no_punct_chars = string.punctuation.replace(\"%\", \"\")\n    9\t        input_str = \"\".join(c for c in input_str.lower() if c not in no_punct_chars)\n   10\t    return re.sub(r\"\\s+\", \" \", input_str).strip()\n   11\t\n   12\t\n   13\tdef normalize_number(pred: str, gold: str):\n   14\t    if pred.endswith(\"%\"):\n   15\t        pred = pred.split(\"%\")[0]\n   16\t        pred = float(pred.replace(\",\", \"\")) / 100\n   17\t    if gold.endswith(\"%\"):\n   18\t        gold = gold.split(\"%\")[0]\n   19\t        gold = float(gold.replace(\",\", \"\")) / 100\n   20\t    return pred, gold\n   21\t\n   22\t\n   23\tdef remove_prefix(input_str, prefix):\n   24\t    if prefix.lower() + \".\" in input_str.lower():\n   25\t        return re.sub(f\"^{prefix.lower()}\\.\", \"\", input_str.lower(), flags=re.IGNORECASE)\n   26\t    return input_str\n   27\t\n   28\t\n   29\tdef is_divisible_by_eight(gold):\n   30\t    return bool(re.match(r\"^\\d+$\", gold)) and int(gold) % 8 == 0\n   31\t\n   32\t\n   33\tdef split_by_comma(s):\n   34\t    m = re.search(r\"^([a-zA-Z])+(?:,|$)\", s)\n   35\t    if m:\n   36\t        opener = m.group()\n   37\t        s = opener.join(s.split(\",\"))\n   38\t    return s\n   39\t\n   40\t\n   41\tdef question_scorer(model_answer: str, gold_answer: str) -> bool:\n   42\t    try:\n   43\t        float(gold_answer)\n   44\t        is_number = True\n   45\t    except Exception:\n   46\t        is_number = False\n   47\t\n   48\t    model_answer = remove_prefix(model_answer, \"Final Answer\")\n   49\t    model_answer = model_answer.replace(\", \", \"\")\n   50\t    try:\n   51\t        return float(model_answer) == float(gold_answer)\n   52\t    except Exception:\n   53\t        pass\n   54\t\n   55\t    try:\n   56\t        return any(float(x) == float(gold_answer) for x in model_answer.split(\" \") if x)\n   57\t    except Exception:\n   58\t        pass\n   59\t\n   60\t    y_n = (\"yes\", \"no\")\n   61\t    is_y_n = any(norm in normalize_str(gold_answer) for norm in y_n) and len(gold_answer) < 20\n   62\t\n   63\t    is_list = \",\" in gold_answer\n   64\t\n   65\t    model_answer = normalize_str(model_answer)\n   66\t    gold_answer = normalize_str(gold_answer)\n   67\t\n   68\t    if is_number:\n   69\t        model_answer, gold_answer = normalize_number(model_answer, gold_answer)\n   70\t    elif is_list:\n   71\t        model_answer = split_by_comma(model_answer)\n   72\t        gold_answer = split_by_comma(gold_answer)\n   73\t    elif not is_y_n:\n   74\t        # drop articles\n   75\t        pass\n   76\t\n   77\t    if model_answer != gold_answer:\n   78\t        return False\n   79\t    return True\n   80\t","toolCallId":"call_00b3d4faaae64709a664f3f8","name":"read"}
{"role":"tool","content":"    1\t# Score full GAIA results and send leaderboard to Telegram (Goated, 6201806207).\n    2\timport json, subprocess, sys\n    3\tfrom pathlib import Path\n    4\tfrom score_full import score_one\n    5\t\n    6\tHERE = Path(__file__).parent\n    7\tENV = Path.home() / \"AppData/Local/hermes/.env\"\n    8\tCHAT = \"6201806207\"\n    9\t\n   10\ttoken = \"\"\n   11\tfor line in ENV.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines():\n   12\t    if line.startswith(\"TELEGRAM_BOT_TOKEN=\"):\n   13\t        token = line.split(\"=\", 1)[1].strip()\n   14\t\n   15\tres = json.load(open(HERE / \"results_full.json\", encoding=\"utf-8\"))\n   16\tby = {1: [0, 0], 2: [0, 0], 3: [0, 0]}\n   17\tfor x in res:\n   18\t    ok = score_one(x[\"got\"], x[\"gold\"])\n   19\t    x[\"correct\"] = ok\n   20\t    if x[\"level\"] in by:\n   21\t        by[x[\"level\"]][1] += 1\n   22\t        by[x[\"level\"]][0] += ok\n   23\tjson.dump(res, open(HERE / \"results_full.json\", \"w\"), indent=1)\n   24\t\n   25\ttok = sum(v[1] for v in by.values()); ok_t = sum(v[0] for v in by.values())\n   26\tlines = [\n   27\t    \"GOATCODE × GAIA — FINAL RESULTS\",\n   28\t    \"Model: free-tier auto-router via FreeLLMAPI proxy ($0) + Goated-Flash-Free fallback · tools: websearch/webfetch/bash/files\",\n   29\t    \"\",\n   30\t    f\"L1: {by[1][0]}/{by[1][1]} = {100*by[1][0]/max(1,by[1][1]):.1f}%\",\n   31\t    f\"L2: {by[2][0]}/{by[2][1]} = {100*by[2][0]/max(1,by[2][1]):.1f}%\",\n   32\t    f\"L3: {by[3][0]}/{by[3][1]} = {100*by[3][0]/max(1,by[3][1]):.1f}%\",\n   33\t    f\"OVERALL: {ok_t}/{tok} = {100*ok_t/max(1,tok):.1f}%\",\n   34\t    \"\",\n   35\t    \"LEADERBOARD (GAIA val, published numbers)\",\n   36\t    \"HAL Claude Sonnet 4.5 .... 74.6% ($178)\",\n   37\t    \"HAL Sonnet 4.5 High ...... 70.9% ($180)\",\n   38\t    \"HF OpenDR GPT-5 .......... 62.8% ($360)\",\n   39\t    \"HAL o4-mini .............. 58.2% ($73)\",\n   40\t    \"HAL Gemini 2.0 Flash ..... 32.7% ($7.8)\",\n   41\t    \"Bare frontier models ..... 45-52%\",\n   42\t    \"GPT-4+plugins (2023) ..... 15%\",\n   43\t    \"Human baseline ........... 92%\",\n   44\t    \"\",\n   45\t    f\"*GoatCode free tier ...... {100*ok_t/max(1,tok):.1f}% ($0.00)*\",\n   46\t]\n   47\tmsg = \"\\n\".join(lines)\n   48\tprint(msg)\n   49\tif token:\n   50\t    r = subprocess.run([\"curl\", \"-s\", \"-X\", \"POST\", f\"https://api.telegram.org/bot{token}/sendMessage\",\n   51\t                        \"-d\", f\"chat_id={CHAT}\", \"--data-urlencode\", f\"text={msg}\",\n   52\t                        \"-o\", \"/dev/null\", \"-w\", \"%{http_code}\"], capture_output=True, text=True)\n   53\t    print(\"TELEGRAM:\", r.stdout.strip() or r.stderr[:120])\n   54\telse:\n   55\t    print(\"NO TOKEN\")\n   56\t","toolCallId":"call_b83d829fad7f4c72b638e49f","name":"read"}
