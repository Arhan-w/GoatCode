{"role":"tool","content":"    1\t# Grade GAIA full results with upstream question_scorer + order-insensitive list compare.\n    2\timport json, re, string, sys\n    3\tfrom collections import defaultdict\n    4\t\n    5\tdef normalize(s):\n    6\t    s = (s or \"\").lower().strip()\n    7\t    punc = string.punctuation.replace(\",\", \"\").replace(\"%\", \"\")\n    8\t    s = \"\".join(c for c in s if c not in punc)\n    9\t    return re.sub(r\"\\s+\", \" \", s).strip()\n   10\t\n   11\tdef num(s):\n   12\t    s = (s or \"\").strip().rstrip(\".\")\n   13\t    try:\n   14\t        if s.endswith(\"%\"):\n   15\t            return float(s[:-1].replace(\",\", \"\")) / 100\n   16\t        return float(s.replace(\",\", \"\"))\n   17\t    except Exception:\n   18\t        return None\n   19\t\n   20\tdef score_one(pred, gold):\n   21\t    p, g = str(pred or \"\"), str(gold or \"\")\n   22\t    # numeric\n   23\t    pn, gn = num(p), num(g)\n   24\t    if gn is not None and pn is not None and abs(pn - gn) < 1e-6:\n   25\t        return True\n   26\t    # normalized string\n   27\t    if normalize(p) == normalize(g) and normalize(g):\n   28\t        return True\n   29\t    # list compare (order-insensitive when elements are comparable)\n   30\t    if \",\" in g:\n   31\t        ge = [normalize(x) for x in g.split(\",\") if normalize(x)]\n   32\t        pe = [normalize(x) for x in p.split(\",\") if normalize(x)]\n   33\t        if ge and pe and sorted(ge) == sorted(pe):\n   34\t            return True\n   35\t    return False\n   36\t\n   37\tif __name__ == \"__main__\":\n   38\t    path = sys.argv[1] if len(sys.argv) > 1 else \"results_full.json\"\n   39\t    res = json.load(open(path, encoding=\"utf-8\"))\n   40\t    by_level = defaultdict(lambda: [0, 0])\n   41\t    for x in res:\n   42\t        ok = score_one(x[\"got\"], x[\"gold\"])\n   43\t        x[\"correct\"] = ok\n   44\t        L = x.get(\"level\", 1)\n   45\t        by_level[L][0] += ok\n   46\t        by_level[L][1] += 1\n   47\t    json.dump(res, open(path, \"w\"), indent=1)\n   48\t    tot_ok = sum(v[0] for v in by_level.values())\n   49\t    tot = sum(v[1] for v in by_level.values())\n   50\t    print(\"per level:\")\n   51\t    for L in sorted(by_level):\n   52\t        ok, n = by_level[L]\n   53\t        print(f\"  L{L}: {ok}/{n} = {100*ok/n:.1f}%\")\n   54\t    print(f\"OVERALL: {tot_ok}/{tot} = {100*tot_ok/tot:.1f}%\")\n   55\t    empty = sum(1 for x in res if not x[\"got\"].strip())\n   56\t    to = sum(1 for x in res if \"TIMEOUT\" in x.get(\"raw_tail\",\"\"))\n   57\t    print(f\"empty answers: {empty} | timeouts: {to}\")\n   58\t    print()\n   59\t    print(\"--- misses ---\")\n   60\t    for x in res:\n   61\t        if not x[\"correct\"]:\n   62\t            print(f\"L{x.get('level',1)} | {x['question'][:64]!r} got={x['got'][:36]!r} gold={str(x['gold'])[:36]!r}\")\n   63\t","toolCallId":"call_79fd49c19e2d44c48a008a98","name":"read"}
{"role":"tool","content":"    1\t# Watchdog: ensures the GAIA finisher keeps running until all 162 are answered,\n    2\t# and that results get sent to Telegram at the end. Run every ~10 min via cron.\n    3\timport json, os, re, subprocess, sys, time\n    4\tfrom pathlib import Path\n    5\t\n    6\tHERE = Path(\"D:/GoatCode-ts/gaia\")\n    7\tJUNK = re.compile(r\"error: LLMError|HTTP 5\\d\\d|Unable to connect|socket conne|TIMEOUT|did not start|stopped after \\d+ steps|^\\[tool \", re.I)\n    8\t\n    9\tdef clean_count():\n   10\t    try:\n   11\t        r = json.load(open(HERE / \"results_full.json\"))\n   12\t        return sum(1 for x in r if not JUNK.search(x[\"got\"]))\n   13\t    except Exception:\n   14\t        return 0\n   15\t\n   16\tn = clean_count()\n   17\tprint(\"clean:\", n, \"/162\")\n   18\tif n >= 162:\n   19\t    # ensure the send happened (idempotent marker)\n   20\t    if not (HERE / \".sent\").exists():\n   21\t        p = subprocess.run([sys.executable, str(HERE / \"send_results.py\")], capture_output=True, text=True, cwd=str(HERE))\n   22\t        print(p.stdout[-400:])\n   23\t        (HERE / \".sent\").write_text(\"ok\")\n   24\t    sys.exit(0)\n   25\t\n   26\t# is a finisher alive?\n   27\tr = subprocess.run([\"powershell\", \"-NoProfile\", \"-Command\",\n   28\t                    \"Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like '*finisher.py*' } | Select-Object -ExpandProperty ProcessId\"],\n   29\t                   capture_output=True, text=True)\n   30\tpids = [p for p in r.stdout.split() if p.strip().isdigit()]\n   31\tif pids:\n   32\t    print(\"finisher alive:\", pids)\n   33\telse:\n   34\t    print(\"restart finisher\")\n   35\t    log = open(HERE / \"finisher.log\", \"a\")\n   36\t    subprocess.Popen([sys.executable, str(HERE / \"finisher.py\")], cwd=str(HERE),\n   37\t                     stdout=log, stderr=subprocess.STDOUT)\n   38\t","toolCallId":"call_f499c4aafdfc410f80d8c4c8","name":"read"}
