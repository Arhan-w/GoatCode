{"role":"tool","content":"    1\t# GAIA validation run for GoatCode (Goated-Flash-Free, zero-config).\r\n    2\t# Sample: N text-only Level-1 questions. Sequential with shared flash server.\r\n    3\timport json, subprocess, sys, time\r\n    4\tfrom pathlib import Path\r\n    5\t\r\n    6\tHERE = Path(__file__).parent\r\n    7\tN = int(sys.argv[1]) if len(sys.argv) > 1 else 10\r\n    8\tGOAT = str((HERE.parent / \"dist\" / \"goat.exe\").resolve())\r\n    9\tHOME = HERE / \".goathome\"\r\n   10\tOUT = HERE / \"results.json\"\r\n   11\t\r\n   12\trows = json.loads((HERE / \"all.json\").read_text())\r\n   13\t# text-only level 1, deterministic sample: first N by task_id sort\r\n   14\tqs = [r for r in rows if str(r[\"Level\"]) == \"1\" and not r.get(\"file_name\")]\r\n   15\tqs.sort(key=lambda r: r[\"task_id\"])\r\n   16\tqs = qs[:N]\r\n   17\tprint(f\"running {len(qs)} level-1 text-only questions\")\r\n   18\t\r\n   19\tPROMPT = (\"You are answering one GAIA benchmark question. Use your websearch and webfetch tools \"\r\n   20\t          \"to research. Think step by step. When certain, end your reply with a line exactly of the form:\\n\"\r\n   21\t          \"ANSWER: <final answer only, as short as possible>\\n\\nQuestion: {q}\\n\")\r\n   22\t\r\n   23\tresults = json.loads(OUT.read_text()) if OUT.exists() else []\r\n   24\tdone = {r[\"task_id\"] for r in results}\r\n   25\t\r\n   26\tfor i, q in enumerate(qs):\r\n   27\t    if q[\"task_id\"] in done:\r\n   28\t        continue\r\n   29\t    import os\r\n   30\t    env = dict(os.environ)\r\n   31\t    env[\"GOATCODE_HOME\"] = str(HOME.resolve())\r\n   32\t    (HERE / \"tmp\").mkdir(exist_ok=True)\r\n   33\t    HOME.mkdir(exist_ok=True)\r\n   34\t    t0 = time.time()\r\n   35\t    try:\r\n   36\t        r = subprocess.run([GOAT, \"-p\", PROMPT.format(q=q[\"Question\"])],\r\n   37\t                           capture_output=True, text=True, timeout=420, env=env,\r\n   38\t                           cwd=str(HERE), encoding=\"utf-8\", errors=\"replace\")\r\n   39\t        out = (r.stdout or \"\") + \"\\n\" + (r.stderr or \"\")\r\n   40\t    except subprocess.TimeoutExpired as e:\r\n   41\t        out = ((e.stdout or b\"\").decode(\"utf-8\", \"replace\") if isinstance(e.stdout, bytes) else (e.stdout or \"\")) + \"\\nTIMEOUT\"\r\n   42\t    elapsed = round(time.time() - t0, 1)\r\n   43\t    ans = \"\"\r\n   44\t    for line in reversed(out.splitlines()):\r\n   45\t        line = line.strip()\r\n   46\t        if line.upper().startswith(\"ANSWER:\"):\r\n   47\t            ans = line[7:].strip()\r\n   48\t            break\r\n   49\t    results.append({\"task_id\": q[\"task_id\"], \"question\": q[\"Question\"][:160],\r\n   50\t                    \"gold\": q[\"Final answer\"], \"got\": ans, \"secs\": elapsed,\r\n   51\t                    \"raw_tail\": out[-400:]})\r\n   52\t    OUT.write_text(json.dumps(results, indent=1))\r\n   53\t    print(f\"[{i+1}/{len(qs)}] {q['task_id'][:8]} {elapsed}s got={ans[:40]!r} gold={str(q['Final answer'])[:40]!r}\", flush=True)\r\n   54\t\r\n   55\tprint(\"DONE\", len(results))\r\n   56\t","toolCallId":"call_d5af3352a8364f3c97e55540","name":"read"}
