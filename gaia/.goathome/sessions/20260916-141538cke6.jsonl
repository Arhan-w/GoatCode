{"role":"tool","content":"    1\t#!/usr/bin/env python3\r\n    2\t\"\"\"\r\n    3\tgemini-web2api - Gemini Web to OpenAI API proxy.\r\n    4\t\r\n    5\tConverts Google Gemini's web interface into an OpenAI-compatible API server.\r\n    6\tZero authentication required. Works on any platform (Windows/macOS/Linux).\r\n    7\t\r\n    8\tUsage:\r\n    9\t    pip install httpx\r\n   10\t    python gemini_web2api.py [--port 8081] [--config config.json]\r\n   11\t\r\n   12\tClient configuration (Cherry Studio, ChatBox, etc.):\r\n   13\t    Base URL: http://localhost:8081/v1\r\n   14\t    API Key: (anything or empty)\r\n   15\t\r\n   16\tHow it works:\r\n   17\t    Sends requests directly to Gemini's public StreamGenerate endpoint.\r\n   18\t    The backend does not verify authentication for basic text generation.\r\n   19\t    Model selection via MODE_CATEGORY field [79] in the request payload.\r\n   20\t    This is NOT a user-tier spoofing attack - the endpoint simply doesn't\r\n   21\t    require auth for anonymous access.\r\n   22\t\"\"\"\r\n   23\timport json\r\n   24\timport urllib.request\r\n   25\timport urllib.parse\r\n   26\timport time\r\n   27\timport ssl\r\n   28\timport sys\r\n   29\timport uuid\r\n   30\timport re\r\n   31\timport os\r\n   32\timport hashlib\r\n   33\timport argparse\r\n   34\timport base64\r\n   35\timport binascii\r\n   36\tfrom typing import Optional\r\n   37\tfrom http.server import HTTPServer, BaseHTTPRequestHandler\r\n   38\tfrom socketserver import ThreadingMixIn\r\n   39\t\r\n   40\ttry:\r\n   41\t    import httpx\r\n   42\t    HAS_HTTPX = True\r\n   43\texcept ImportError:\r\n   44\t    HAS_HTTPX = False\r\n   45\t\r\n   46\t__version__ = \"1.1.0\"\r\n   47\t\r\n   48\t# ─── Configuration ───────────────────────────────────────────────────────────\r\n   49\t\r\n   50\tDEFAULT_CONFIG = {\r\n... [1087 more lines]","toolCallId":"call_4f110a208c054bfb93caa938","name":"read"}
{"role":"tool","content":"    1\t# GAIA validation run for GoatCode (Goated-Flash-Free, zero-config).\r\n    2\t# Sample: N text-only Level-1 questions. Sequential with shared flash server.\r\n    3\timport json, subprocess, sys, time\r\n    4\tfrom pathlib import Path\r\n    5\t\r\n    6\tHERE = Path(__file__).parent\r\n    7\tN = int(sys.argv[1]) if len(sys.argv) > 1 else 10\r\n    8\tGOAT = str((HERE.parent / \"dist\" / \"goat.exe\").resolve())\r\n    9\tHOME = HERE / \".goathome\"\r\n   10\tOUT = HERE / \"results.json\"\r\n   11\t\r\n   12\trows = json.loads((HERE / \"all.json\").read_text())\r\n   13\t# text-only level 1, deterministic sample: first N by task_id sort\r\n   14\tqs = [r for r in rows if str(r[\"Level\"]) == \"1\" and not r.get(\"file_name\")]\r\n   15\tqs.sort(key=lambda r: r[\"task_id\"])\r\n   16\tqs = qs[:N]\r\n   17\tprint(f\"running {len(qs)} level-1 text-only questions\")\r\n   18\t\r\n   19\tPROMPT = (\"You are answering one GAIA benchmark question. Use your websearch and webfetch tools \"\r\n   20\t          \"to research. Think step by step. When certain, end your reply with a line exactly of the form:\\n\"\r\n   21\t          \"ANSWER: <final answer only, as short as possible>\\n\\nQuestion: {q}\\n\")\r\n   22\t\r\n   23\tresults = json.loads(OUT.read_text()) if OUT.exists() else []\r\n   24\tdone = {r[\"task_id\"] for r in results}\r\n   25\t\r\n   26\tfor i, q in enumerate(qs):\r\n   27\t    if q[\"task_id\"] in done:\r\n   28\t        continue\r\n   29\t    import os\r\n   30\t    env = dict(os.environ)\r\n   31\t    env[\"GOATCODE_HOME\"] = str(HOME.resolve())\r\n   32\t    (HERE / \"tmp\").mkdir(exist_ok=True)\r\n   33\t    HOME.mkdir(exist_ok=True)\r\n   34\t    t0 = time.time()\r\n   35\t    try:\r\n   36\t        r = subprocess.run([GOAT, \"-p\", PROMPT.format(q=q[\"Question\"])],\r\n   37\t                           capture_output=True, text=True, timeout=420, env=env,\r\n   38\t                           cwd=str(HERE), encoding=\"utf-8\", errors=\"replace\")\r\n   39\t        out = (r.stdout or \"\") + \"\\n\" + (r.stderr or \"\")\r\n   40\t    except subprocess.TimeoutExpired as e:\r\n   41\t        out = ((e.stdout or b\"\").decode(\"utf-8\", \"replace\") if isinstance(e.stdout, bytes) else (e.stdout or \"\")) + \"\\nTIMEOUT\"\r\n   42\t    elapsed = round(time.time() - t0, 1)\r\n   43\t    ans = \"\"\r\n   44\t    for line in reversed(out.splitlines()):\r\n   45\t        line = line.strip()\r\n   46\t        if line.upper().startswith(\"ANSWER:\"):\r\n   47\t            ans = line[7:].strip()\r\n   48\t            break\r\n   49\t    results.append({\"task_id\": q[\"task_id\"], \"question\": q[\"Question\"][:160],\r\n   50\t                    \"gold\": q[\"Final answer\"], \"got\": ans, \"secs\": elapsed,\r\n... [6 more lines]","toolCallId":"call_9b67e8bf62924760a74f6149","name":"read"}
{"role":"tool","content":"    1\t# Wait for upstream recovery, then finish GAIA with slow, gentle rounds; score + Telegram.\n    2\timport json, os, re, subprocess, sys, time\n    3\tfrom pathlib import Path\n    4\tfrom concurrent.futures import ThreadPoolExecutor, as_completed\n    5\t\n    6\tHERE = Path(__file__).parent\n    7\tGOAT = str((HERE.parent / \"dist\" / \"goat.exe\").resolve())\n    8\tHOME = HERE / \".goathome\"\n    9\tOUT = HERE / \"results_full.json\"\n   10\tDATA = HERE / \"data\"\n   11\tSKIP_EXT = {\".mp3\", \".wav\", \".m4a\"}\n   12\tJUNK = re.compile(r\"error: LLMError|HTTP 5\\d\\d|Unable to connect|socket conne|TIMEOUT|did not start|stopped after \\d+ steps|^\\[tool \", re.I)\n   13\t\n   14\trows = json.loads((HERE / \"all.json\").read_text())\n   15\ttasks = {}\n   16\tfor r in rows:\n   17\t    fn = r.get(\"file_name\")\n   18\t    if fn and (Path(fn).suffix.lower() in SKIP_EXT or not (DATA / fn).exists()):\n   19\t        continue\n   20\t    tasks[r[\"task_id\"]] = {\"level\": int(r[\"Level\"]), \"gold\": r[\"Final answer\"],\n   21\t                           \"file\": str(DATA / fn) if fn else None, \"question\": r[\"Question\"]}\n   22\t\n   23\tres = json.loads(OUT.read_text()) if OUT.exists() else []\n   24\tclean = {x[\"task_id\"]: x for x in res if not JUNK.search(x[\"got\"])}\n   25\tprint(f\"resume: {len(clean)}/{len(tasks)} clean\", flush=True)\n   26\t\n   27\tPROMPT_TMPL = (\n   28\t    \"You are answering one GAIA benchmark question.\\n{file_note}\"\n   29\t    \"Use your websearch and webfetch tools to research facts, and bash/read tools for files.\\n\"\n   30\t    \"Think step by step and verify before concluding.\\n\"\n   31\t    \"IMPORTANT: your reply MUST end with a final line exactly of the form:\\n\"\n   32\t    \"ANSWER: <final answer only, as short as possible>\\nNever finish without that line.\\n\\n\"\n   33\t    \"Question: {q}\\n\"\n   34\t)\n   35\t\n   36\tdef extract(out):\n   37\t    lines = [l.strip() for l in out.splitlines() if l.strip()]\n   38\t    for line in reversed(lines):\n   39\t        if line.upper().startswith(\"ANSWER:\"):\n   40\t            return line[7:].strip().strip(\"*_`\").strip()\n   41\t    for line in reversed(lines):\n   42\t        if line and not line.lower().startswith((\"╭\", \"│\", \"╰\", \"ask before edits\", \"ctrl+t\", \"esc to\")):\n   43\t            return line[:200]\n   44\t    return \"\"\n   45\t\n   46\tdef invoke(prompt):\n   47\t    env = dict(os.environ)\n   48\t    env[\"GOATCODE_HOME\"] = str(HOME.resolve())\n   49\t    env[\"GOAT_MAX_STEPS\"] = \"60\"\n   50\t    t0 = time.time()\n... [74 more lines]","toolCallId":"call_f09aa6bded05473dad7ddc9a","name":"read"}
