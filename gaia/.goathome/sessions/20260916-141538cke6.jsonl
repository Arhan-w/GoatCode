{"role":"tool","content":"    1\t# GAIA validation — FULL run (all levels, text + file questions).\n    2\t# Fixes vs run.py: forced ANSWER tail, fallback extraction, file paths handed to agent,\n    3\t# larger step budget, order-tolerant scoring done separately.\n    4\timport json, os, subprocess, sys, time\n    5\tfrom pathlib import Path\n    6\t\n    7\tHERE = Path(__file__).parent\n    8\tLIMIT = int(sys.argv[1]) if len(sys.argv) > 1 else 999\n    9\tGOAT = str((HERE.parent / \"dist\" / \"goat.exe\").resolve())\n   10\tHOME = HERE / \".goathome\"\n   11\tOUT = HERE / \"results_full.json\"\n   12\tDATA = HERE / \"data\"\n   13\t\n   14\tSKIP_EXT = {\".mp3\", \".wav\", \".m4a\"}  # no audio pipeline in free tier\n   15\t\n   16\trows = json.loads((HERE / \"all.json\").read_text())\n   17\tqs = []\n   18\tfor r in rows:\n   19\t    fn = r.get(\"file_name\")\n   20\t    if fn and Path(fn).suffix.lower() in SKIP_EXT:\n   21\t        continue\n   22\t    if fn and not (DATA / fn).exists():\n   23\t        continue\n   24\t    qs.append(r)\n   25\tqs.sort(key=lambda r: (int(r[\"Level\"]), r[\"task_id\"]))\n   26\tqs = qs[:LIMIT]\n   27\tprint(f\"running {len(qs)} questions (all levels)\", flush=True)\n   28\t\n   29\tPROMPT_TMPL = (\n   30\t    \"You are answering one GAIA benchmark question.\\n\"\n   31\t    \"{file_note}\"\n   32\t    \"Use your websearch and webfetch tools to research facts, and bash/read tools for files.\\n\"\n   33\t    \"Think step by step and verify before concluding.\\n\"\n   34\t    \"IMPORTANT: your reply MUST end with a final line exactly of the form:\\n\"\n   35\t    \"ANSWER: <final answer only, as short as possible — no punctuation added, no unit unless asked>\\n\"\n   36\t    \"Never finish without that line.\\n\\n\"\n   37\t    \"Question: {q}\\n\"\n   38\t)\n   39\t\n   40\tdef extract(out: str) -> str:\n   41\t    lines = [l.strip() for l in out.splitlines() if l.strip()]\n   42\t    for line in reversed(lines):\n   43\t        u = line.upper()\n   44\t        if u.startswith(\"ANSWER:\"):\n   45\t            return line[7:].strip().strip('*_`').strip()\n   46\t    # fallbacks: last content line that isn't a spinner/footer\n   47\t    for line in reversed(lines):\n   48\t        low = line.lower()\n   49\t        if line and not low.startswith((\"╭\", \"│\", \"╰\", \"ask before edits\", \"ctrl+t\", \"esc to\", \"⠋\", \"⠙\")):\n   50\t            return line[:200]\n   51\t    return \"\"\n   52\t\n   53\tresults = json.loads(OUT.read_text()) if OUT.exists() else []\n   54\tresults = [x for x in results if \"HTTP 502\" not in x[\"got\"]]  # requeue rate-limited\n   55\tdone = {r[\"task_id\"] for r in results}\n   56\t\n   57\tenv = dict(os.environ)\n   58\tenv[\"GOATCODE_HOME\"] = str(HOME.resolve())\n   59\tenv[\"GOAT_MAX_STEPS\"] = \"25\"\n   60\t\n   61\tfor i, q in enumerate(qs):\n   62\t    if q[\"task_id\"] in done:\n   63\t        continue\n   64\t    fn = q.get(\"file_name\")\n   65\t    file_note = f\"A data file for this question is at: {DATA / fn}\\n\" if fn else \"\"\n   66\t    prompt = PROMPT_TMPL.format(file_note=file_note, q=q[\"Question\"])\n   67\t    t0 = time.time()\n   68\t    for attempt in range(4):\n   69\t        try:\n   70\t            r = subprocess.run([GOAT, \"-p\", prompt], capture_output=True, text=True,\n   71\t                               timeout=600, env=env, cwd=str(HERE), encoding=\"utf-8\", errors=\"replace\")\n   72\t            out = (r.stdout or \"\") + \"\\n\" + (r.stderr or \"\")\n   73\t        except subprocess.TimeoutExpired as e:\n   74\t            out = ((e.stdout or b\"\").decode(\"utf-8\", \"replace\") if isinstance(e.stdout, bytes) else (e.stdout or \"\")) + \"\\nTIMEOUT\"\n   75\t        if \"HTTP 502\" not in out:\n   76\t            break\n   77\t        wait = 90 * (attempt + 1)\n   78\t        print(f\"  502 on {q['task_id'][:8]}, cooldown {wait}s\", flush=True)\n   79\t        time.sleep(wait)\n   80\t    elapsed = round(time.time() - t0, 1)\n... [10 more lines]","toolCallId":"call_3b7ec42e7b1d4f43b62514ef","name":"read"}
{"role":"tool","content":"    1\t# Upstream GAIA question_scorer (bug-for-bug: \"3,676\" parses as a 2-element list).\n    2\timport re\n    3\timport string\n    4\t\n    5\t\n    6\tdef normalize_str(input_str, remove_punct=True):\n    7\t    if remove_punct:\n    8\t        no_punct_chars = string.punctuation.replace(\"%\", \"\")\n    9\t        input_str = \"\".join(c for c in input_str.lower() if c not in no_punct_chars)\n   10\t    return re.sub(r\"\\s+\", \" \", input_str).strip()\n   11\t\n   12\t\n   13\tdef normalize_number(pred: str, gold: str):\n   14\t    if pred.endswith(\"%\"):\n   15\t        pred = pred.split(\"%\")[0]\n   16\t        pred = float(pred.replace(\",\", \"\")) / 100\n   17\t    if gold.endswith(\"%\"):\n   18\t        gold = gold.split(\"%\")[0]\n   19\t        gold = float(gold.replace(\",\", \"\")) / 100\n   20\t    return pred, gold\n   21\t\n   22\t\n   23\tdef remove_prefix(input_str, prefix):\n   24\t    if prefix.lower() + \".\" in input_str.lower():\n   25\t        return re.sub(f\"^{prefix.lower()}\\.\", \"\", input_str.lower(), flags=re.IGNORECASE)\n   26\t    return input_str\n   27\t\n   28\t\n   29\tdef is_divisible_by_eight(gold):\n   30\t    return bool(re.match(r\"^\\d+$\", gold)) and int(gold) % 8 == 0\n   31\t\n   32\t\n   33\tdef split_by_comma(s):\n   34\t    m = re.search(r\"^([a-zA-Z])+(?:,|$)\", s)\n   35\t    if m:\n   36\t        opener = m.group()\n   37\t        s = opener.join(s.split(\",\"))\n   38\t    return s\n   39\t\n   40\t\n   41\tdef question_scorer(model_answer: str, gold_answer: str) -> bool:\n   42\t    try:\n   43\t        float(gold_answer)\n   44\t        is_number = True\n   45\t    except Exception:\n   46\t        is_number = False\n   47\t\n   48\t    model_answer = remove_prefix(model_answer, \"Final Answer\")\n   49\t    model_answer = model_answer.replace(\", \", \"\")\n   50\t    try:\n   51\t        return float(model_answer) == float(gold_answer)\n   52\t    except Exception:\n   53\t        pass\n   54\t\n   55\t    try:\n   56\t        return any(float(x) == float(gold_answer) for x in model_answer.split(\" \") if x)\n   57\t    except Exception:\n   58\t        pass\n   59\t\n   60\t    y_n = (\"yes\", \"no\")\n   61\t    is_y_n = any(norm in normalize_str(gold_answer) for norm in y_n) and len(gold_answer) < 20\n   62\t\n   63\t    is_list = \",\" in gold_answer\n   64\t\n   65\t    model_answer = normalize_str(model_answer)\n   66\t    gold_answer = normalize_str(gold_answer)\n   67\t\n   68\t    if is_number:\n   69\t        model_answer, gold_answer = normalize_number(model_answer, gold_answer)\n   70\t    elif is_list:\n   71\t        model_answer = split_by_comma(model_answer)\n   72\t        gold_answer = split_by_comma(gold_answer)\n   73\t    elif not is_y_n:\n   74\t        # drop articles\n   75\t        pass\n   76\t\n   77\t    if model_answer != gold_answer:\n   78\t        return False\n   79\t    return True\n   80\t","toolCallId":"call_6baddcebe61c4748a1b3c766","name":"read"}
{"role":"tool","content":"    1\t# Score full GAIA results and send leaderboard to Telegram (Goated, 6201806207).\n    2\timport json, subprocess, sys\n    3\tfrom pathlib import Path\n    4\tfrom score_full import score_one\n    5\t\n    6\tHERE = Path(__file__).parent\n    7\tENV = Path.home() / \"AppData/Local/hermes/.env\"\n    8\tCHAT = \"6201806207\"\n    9\t\n   10\ttoken = \"\"\n   11\tfor line in ENV.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines():\n   12\t    if line.startswith(\"TELEGRAM_BOT_TOKEN=\"):\n   13\t        token = line.split(\"=\", 1)[1].strip()\n   14\t\n   15\tres = json.load(open(HERE / \"results_full.json\", encoding=\"utf-8\"))\n   16\tby = {1: [0, 0], 2: [0, 0], 3: [0, 0]}\n   17\tfor x in res:\n   18\t    ok = score_one(x[\"got\"], x[\"gold\"])\n   19\t    x[\"correct\"] = ok\n   20\t    if x[\"level\"] in by:\n   21\t        by[x[\"level\"]][1] += 1\n   22\t        by[x[\"level\"]][0] += ok\n   23\tjson.dump(res, open(HERE / \"results_full.json\", \"w\"), indent=1)\n   24\t\n   25\ttok = sum(v[1] for v in by.values()); ok_t = sum(v[0] for v in by.values())\n   26\tlines = [\n   27\t    \"GOATCODE × GAIA — FINAL RESULTS\",\n   28\t    \"Model: free-tier auto-router via FreeLLMAPI proxy ($0) + Goated-Flash-Free fallback · tools: websearch/webfetch/bash/files\",\n   29\t    \"\",\n   30\t    f\"L1: {by[1][0]}/{by[1][1]} = {100*by[1][0]/max(1,by[1][1]):.1f}%\",\n   31\t    f\"L2: {by[2][0]}/{by[2][1]} = {100*by[2][0]/max(1,by[2][1]):.1f}%\",\n   32\t    f\"L3: {by[3][0]}/{by[3][1]} = {100*by[3][0]/max(1,by[3][1]):.1f}%\",\n   33\t    f\"OVERALL: {ok_t}/{tok} = {100*ok_t/max(1,tok):.1f}%\",\n   34\t    \"\",\n   35\t    \"LEADERBOARD (GAIA val, published numbers)\",\n   36\t    \"HAL Claude Sonnet 4.5 .... 74.6% ($178)\",\n   37\t    \"HAL Sonnet 4.5 High ...... 70.9% ($180)\",\n   38\t    \"HF OpenDR GPT-5 .......... 62.8% ($360)\",\n   39\t    \"HAL o4-mini .............. 58.2% ($73)\",\n   40\t    \"HAL Gemini 2.0 Flash ..... 32.7% ($7.8)\",\n   41\t    \"Bare frontier models ..... 45-52%\",\n   42\t    \"GPT-4+plugins (2023) ..... 15%\",\n   43\t    \"Human baseline ........... 92%\",\n   44\t    \"\",\n   45\t    f\"*GoatCode free tier ...... {100*ok_t/max(1,tok):.1f}% ($0.00)*\",\n   46\t]\n   47\tmsg = \"\\n\".join(lines)\n   48\tprint(msg)\n   49\tif token:\n   50\t    r = subprocess.run([\"curl\", \"-s\", \"-X\", \"POST\", f\"https://api.telegram.org/bot{token}/sendMessage\",\n   51\t                        \"-d\", f\"chat_id={CHAT}\", \"--data-urlencode\", f\"text={msg}\",\n   52\t                        \"-o\", \"/dev/null\", \"-w\", \"%{http_code}\"], capture_output=True, text=True)\n   53\t    print(\"TELEGRAM:\", r.stdout.strip() or r.stderr[:120])\n   54\telse:\n   55\t    print(\"NO TOKEN\")\n   56\t","toolCallId":"call_bda9eb8b76464dda971b9df8","name":"read"}
