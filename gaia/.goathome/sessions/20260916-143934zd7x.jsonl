{"role":"tool","content":"    1\t#!/usr/bin/env python3\r\n    2\t\"\"\"\r\n    3\tgemini-web2api - Gemini Web to OpenAI API proxy.\r\n    4\t\r\n    5\tConverts Google Gemini's web interface into an OpenAI-compatible API server.\r\n    6\tZero authentication required. Works on any platform (Windows/macOS/Linux).\r\n    7\t\r\n    8\tUsage:\r\n    9\t    pip install httpx\r\n   10\t    python gemini_web2api.py [--port 8081] [--config config.json]\r\n   11\t\r\n   12\tClient configuration (Cherry Studio, ChatBox, etc.):\r\n   13\t    Base URL: http://localhost:8081/v1\r\n   14\t    API Key: (anything or empty)\r\n   15\t\r\n   16\tHow it works:\r\n   17\t    Sends requests directly to Gemini's public StreamGenerate endpoint.\r\n   18\t    The backend does not verify authentication for basic text generation.\r\n   19\t    Model selection via MODE_CATEGORY field [79] in the request payload.\r\n   20\t    This is NOT a user-tier spoofing attack - the endpoint simply doesn't\r\n   21\t    require auth for anonymous access.\r\n   22\t\"\"\"\r\n   23\timport json\r\n   24\timport urllib.request\r\n   25\timport urllib.parse\r\n   26\timport time\r\n   27\timport ssl\r\n   28\timport sys\r\n   29\timport uuid\r\n   30\timport re\r\n   31\timport os\r\n   32\timport hashlib\r\n   33\timport argparse\r\n   34\timport base64\r\n   35\timport binascii\r\n   36\tfrom typing import Optional\r\n   37\tfrom http.server import HTTPServer, BaseHTTPRequestHandler\r\n   38\tfrom socketserver import ThreadingMixIn\r\n   39\t\r\n   40\ttry:\r\n   41\t    import httpx\r\n   42\t    HAS_HTTPX = True\r\n   43\texcept ImportError:\r\n   44\t    HAS_HTTPX = False\r\n   45\t\r\n   46\t__version__ = \"1.1.0\"\r\n   47\t\r\n   48\t# ─── Configuration ───────────────────────────────────────────────────────────\r\n   49\t\r\n   50\tDEFAULT_CONFIG = {\r\n   51\t    \"port\": 8081,\r\n   52\t    # Goated fork: bind loopback only — the server is embedded in GoatCode\r\n   53\t    # and must never be reachable from the LAN.\r\n   54\t    \"host\": \"127.0.0.1\",\r\n   55\t    \"retry_attempts\": 3,\r\n   56\t    \"retry_delay_sec\": 2,\r\n   57\t    \"request_timeout_sec\": 180,\r\n   58\t    \"gemini_bl\": \"boq_assistant-bard-web-server_20260716.08_p0\",\r\n   59\t    \"auth_user\": None,\r\n   60\t    \"xsrf_token\": None,\r\n   61\t    \"default_model\": \"goated-flash\",\r\n   62\t    \"log_requests\": True,\r\n   63\t    \"cookie_file\": None,\r\n   64\t    \"proxy\": None,\r\n   65\t    \"api_keys\": [],\r\n   66\t    \"temporary_chats\": False,\r\n   67\t}\r\n   68\t\r\n   69\tCONFIG = dict(DEFAULT_CONFIG)\r\n   70\t\r\n   71\t# ─── Models ──────────────────────────────────────────────────────────────────\r\n   72\t# Mapping from JS source: MODE_CATEGORY enum (028-6eb337387583.js)\r\n   73\t#   1=FAST, 2=THINKING, 3=PRO, 4=AUTO, 5=FAST_DYNAMIC_THINKING, 6=FLASH_LITE\r\n   74\t\r\n   75\tMODELS = {\r\n   76\t    \"gemini-3.7-flash\": {\r\n   77\t        \"mode\": 1, \"think\": 4,\r\n   78\t        \"desc\": \"Latest all-around model (Gemini 3.7 Flash)\",\r\n   79\t    },\r\n   80\t    \"gemini-3.6-flash\": {\r\n   81\t        \"mode\": 1, \"think\": 4,\r\n   82\t        \"desc\": \"All-around model (Gemini 3.6 Flash)\",\r\n   83\t    },\r\n   84\t    \"gemini-3.5-flash\": {\r\n   85\t        \"mode\": 1, \"think\": 4,\r\n   86\t        \"desc\": \"Alias for gemini-3.6-flash (backend upgraded)\",\r\n   87\t    },\r\n   88\t    \"gemini-3.5-flash-thinking\": {\r\n   89\t        \"mode\": 2, \"think\": 0,\r\n   90\t        \"desc\": \"Deep thinking mode, longest output (~20k chars)\",\r\n   91\t    },\r\n   92\t    \"gemini-3.1-pro\": {\r\n   93\t        \"mode\": 3, \"think\": 4,\r\n   94\t        \"desc\": \"Pro model (requires cookie for real routing)\",\r\n   95\t    },\r\n   96\t    \"gemini-auto\": {\r\n   97\t        \"mode\": 4, \"think\": 4,\r\n   98\t        \"desc\": \"Auto model selection\",\r\n   99\t    },\r\n  100\t    \"gemini-3.5-flash-thinking-lite\": {\r\n  101\t        \"mode\": 5, \"think\": 0,\r\n  102\t        \"desc\": \"Dynamic thinking with adaptive depth\",\r\n  103\t    },\r\n  104\t    \"gemini-flash-lite\": {\r\n  105\t        \"mode\": 6, \"think\": 4,\r\n  106\t        \"desc\": \"Lightweight fast model\",\r\n  107\t    },\r\n  108\t}\r\n  109\t\r\n  110\t# ─── Goated aliases (brand-neutral names for the Goated-Flash-Free tier)\r\n  111\tfor _ga, _gb in {\r\n  112\t    \"goated-flash\": \"gemini-3.5-flash\",\r\n  113\t    \"goated-1-flash\": \"gemini-3.5-flash\",\r\n  114\t    \"goated-2-flash\": \"gemini-3.6-flash\",\r\n  115\t    \"goated-3-flash\": \"gemini-3.7-flash\",\r\n  116\t    \"goated-1-flash-thinking\": \"gemini-3.5-flash-thinking\",\r\n  117\t    \"goated-flash-lite\": \"gemini-flash-lite\",\r\n  118\t    \"goated-pro\": \"gemini-3.1-pro\",\r\n  119\t    \"goated-auto\": \"gemini-auto\",\r\n  120\t}.items():\r\n  121\t    if _gb in MODELS:\r\n  122\t        _c = dict(MODELS[_gb])\r\n  123\t        _c[\"desc\"] = _c.get(\"desc\", \"\").replace(\"Gemini\", \"Goated\").replace(\"gemini-\", \"goated-\")\r\n  124\t        MODELS[_ga] = _c\r\n  125\tfor _gb in [k for k in MODELS if k.startswith(\"gemini-\")]:\r\n  126\t    del MODELS[_gb]\r\n  127\t\r\n  128\t\r\n  129\t# ─── Utilities ───────────────────────────────────────────────────────────────\r\n  130\t\r\n  131\tdef log(msg: str):\r\n  132\t    if CONFIG[\"log_requests\"]:\r\n  133\t        sys.stderr.write(f\"[{time.strftime('%H:%M:%S')}] {msg}\\n\")\r\n  134\t        sys.stderr.flush()\r\n  135\t\r\n  136\t\r\n  137\tdef load_cookie() -> tuple:\r\n  138\t    \"\"\"Load cookie from file. Returns (cookie_str, sapisid).\"\"\"\r\n  139\t    cookie_file = CONFIG.get(\"cookie_file\")\r\n  140\t    if not cookie_file:\r\n  141\t        return \"\", None\r\n  142\t    if not os.path.exists(cookie_file):\r\n  143\t        return \"\", None\r\n  144\t    try:\r\n  145\t        with open(cookie_file, \"r\") as f:\r\n  146\t            content = f.read().strip()\r\n  147\t        if content.startswith(\"{\"):\r\n  148\t            data = json.loads(content)\r\n  149\t            cookie_str = data.get(\"cookie\", \"\")\r\n  150\t            sapisid = data.get(\"sapisid\", \"\")\r\n  151\t        else:\r\n  152\t            cookie_str = content\r\n  153\t            pairs = dict(p.split(\"=\", 1) for p in cookie_str.split(\"; \") if \"=\" in p)\r\n  154\t            sapisid = pairs.get(\"SAPISID\", \"\")\r\n  155\t        return cookie_str, sapisid if sapisid else None\r\n  156\t    except Exception as e:\r\n  157\t        log(f\"Cookie load error: {e}\")\r\n  158\t        return \"\", None\r\n  159\t\r\n  160\t\r\n  161\tdef make_sapisidhash(sapisid: str) -> str:\r\n  162\t    ts = int(time.time())\r\n  163\t    h = hashlib.sha1(f\"{ts} {sapisid} https://gemini.google.com\".encode()).hexdigest()\r\n  164\t    return f\"SAPISIDHASH {ts}_{h}\"\r\n  165\t\r\n  166\t\r\n  167\tdef account_prefix() -> str:\r\n  168\t    \"\"\"Return the Gemini account path prefix for non-default Google accounts.\"\"\"\r\n  169\t    auth_user = CONFIG.get(\"auth_user\")\r\n  170\t    if auth_user is None or auth_user == \"\":\r\n  171\t        return \"\"\r\n  172\t    return f\"/u/{auth_user}\"\r\n  173\t\r\n  174\t\r\n  175\tdef apply_chat_persistence_flags(inner: list) -> None:\r\n  176\t    \"\"\"Apply Gemini Web persistence flags to an outgoing request payload.\"\"\"\r\n  177\t    if CONFIG.get(\"temporary_chats\", False):\r\n  178\t        inner[41] = [1]\r\n  179\t        inner[45] = 1\r\n  180\t    else:\r\n  181\t        inner[41] = [2]\r\n  182\t\r\n  183\t\r\n  184\tdef fetch_latest_bl() -> Optional[str]:\r\n  185\t    \"\"\"Fetch the latest gemini_bl from gemini.google.com page.\"\"\"\r\n  186\t    try:\r\n  187\t        req = urllib.request.Request(\r\n  188\t            \"https://gemini.google.com/app\",\r\n  189\t            headers={\"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\"})\r\n  190\t        ctx = ssl.create_default_context()\r\n  191\t        proxy = CONFIG.get(\"proxy\")\r\n  192\t        if proxy:\r\n  193\t            opener = urllib.request.build_opener(\r\n  194\t                urllib.request.ProxyHandler({\"http\": proxy, \"https\": proxy}),\r\n  195\t                urllib.request.HTTPSHandler(context=ctx))\r\n  196\t            resp = opener.open(req, timeout=15)\r\n  197\t        else:\r\n  198\t            resp = urllib.request.urlopen(req, context=ctx, timeout=15)\r\n  199\t        html = resp.read().decode(\"utf-8\", errors=\"replace\")\r\n  200\t        m = re.search(r'(boq_assistant-bard-web-server_\\d+\\.\\d+_p\\d+)', html)\r\n  201\t        if m:\r\n  202\t            return m.group(1)\r\n  203\t    except Exception as e:\r\n  204\t        log(f\"BL auto-update fetch failed: {e}\")\r\n  205\t    return None\r\n  206\t\r\n  207\t\r\n  208\tdef update_bl_if_needed() -> bool:\r\n  209\t    \"\"\"Attempt to fetch and update gemini_bl. Returns True if updated.\"\"\"\r\n  210\t    new_bl = fetch_latest_bl()\r\n  211\t    if new_bl and new_bl != CONFIG[\"gemini_bl\"]:\r\n  212\t        log(f\"BL auto-updated: {CONFIG['gemini_bl']} -> {new_bl}\")\r\n  213\t        CONFIG[\"gemini_bl\"] = new_bl\r\n  214\t        return True\r\n  215\t    return False\r\n  216\t\r\n  217\t\r\n  218\tdef upload_images(images: list) -> list:\r\n  219\t    \"\"\"Upload parsed OpenAI image parts and return Gemini file references.\"\"\"\r\n  220\t    if not images:\r\n  221\t        return None\r\n  222\t    from gemini_web2api.multimodal import detect_image_mime, fetch_image_bytes, upload_image\r\n  223\t\r\n  224\t    file_refs = []\r\n  225\t    for item in images:\r\n  226\t        if not (isinstance(item, tuple) and len(item) == 2):\r\n  227\t            continue\r\n  228\t        data, mime = item\r\n  229\t        if isinstance(data, str):\r\n  230\t            data = fetch_image_bytes(data)\r\n  231\t            mime = mime or \"image/png\"\r\n  232\t        if not data:\r\n  233\t            raise RuntimeError(\"image fetch failed\")\r\n  234\t        mime = detect_image_mime(data, mime or \"image/png\")\r\n  235\t        try:\r\n  236\t            file_refs.append(upload_image(data, \"image.png\", mime or \"image/png\"))\r\n  237\t        except Exception as e:\r\n  238\t            raise RuntimeError(f\"image upload failed: {e}\") from e\r\n  239\t    return file_refs if file_refs else None\r\n  240\t\r\n  241\t\r\n  242\t# ─── Gemini Protocol ─────────────────────────────────────────────────────────\r\n  243\t\r\n  244\tdef gemini_stream_generate(prompt: str, model_id: int, think_mode: int, file_refs: list = None) -> str:\r\n  245\t    \"\"\"Send prompt to Gemini StreamGenerate with retry.\"\"\"\r\n  246\t    inner = [None] * 80\r\n  247\t    if file_refs:\r\n  248\t        refs = [[None, None, ref] for ref in file_refs]\r\n  249\t        inner[0] = [prompt, 0, None, refs, None, None, 0]\r\n  250\t    else:\r\n  251\t        inner[0] = [prompt, 0, None, None, None, None, 0]\r\n  252\t    inner[1] = [\"en\"]\r\n  253\t    inner[2] = [\"\", \"\", \"\", None, None, None, None, None, None, \"\"]\r\n  254\t    inner[6] = [0]\r\n  255\t    inner[7] = 1\r\n  256\t    inner[10] = 1\r\n  257\t    inner[11] = 0\r\n  258\t    inner[17] = [[think_mode]]\r\n  259\t    inner[18] = 0\r\n  260\t    inner[27] = 1\r\n  261\t    inner[30] = [4]\r\n  262\t    apply_chat_persistence_flags(inner)\r\n  263\t    inner[53] = 0\r\n  264\t    inner[59] = str(uuid.uuid4())\r\n  265\t    inner[61] = []\r\n  266\t    inner[68] = 1\r\n  267\t    inner[79] = model_id\r\n  268\t\r\n  269\t    outer = [None, json.dumps(inner)]\r\n  270\t    params = {\"f.req\": json.dumps(outer)}\r\n  271\t    if CONFIG.get(\"xsrf_token\"):\r\n  272\t        params[\"at\"] = CONFIG[\"xsrf_token\"]\r\n  273\t    body = urllib.parse.urlencode(params).encode()\r\n  274\t    reqid = int(time.time()) % 1000000\r\n  275\t    prefix = account_prefix()\r\n  276\t    url = (\r\n  277\t        f\"https://gemini.google.com{prefix}/_/BardChatUi/data/\"\r\n  278\t        \"assistant.lamda.BardFrontendService/StreamGenerate\"\r\n  279\t        f\"?bl={CONFIG['gemini_bl']}&hl=en&_reqid={reqid}&rt=c\"\r\n  280\t    )\r\n  281\t    headers = {\r\n  282\t        \"Content-Type\": \"application/x-www-form-urlencoded\",\r\n  283\t        \"Origin\": \"https://gemini.google.com\",\r\n  284\t        \"Referer\": f\"https://gemini.google.com{prefix}/app\",\r\n  285\t        \"X-Same-Domain\": \"1\",\r\n  286\t        \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\",\r\n  287\t    }\r\n  288\t    if prefix:\r\n  289\t        headers[\"X-Goog-AuthUser\"] = str(CONFIG[\"auth_user\"])\r\n  290\t\r\n  291\t    cookie_str, sapisid = load_cookie()\r\n  292\t    if cookie_str:\r\n  293\t        headers[\"Cookie\"] = cookie_str\r\n  294\t    if sapisid:\r\n  295\t        headers[\"Authorization\"] = make_sapisidhash(sapisid)\r\n  296\t\r\n  297\t    last_err = None\r\n  298\t    for attempt in range(CONFIG[\"retry_attempts\"]):\r\n  299\t        try:\r\n  300\t            req = urllib.request.Request(url, data=body, headers=headers, method=\"POST\")\r\n  301\t            ctx = ssl.create_default_context()\r\n  302\t            proxy = CONFIG.get(\"proxy\")\r\n  303\t            if proxy:\r\n  304\t                opener = urllib.request.build_opener(\r\n  305\t                    urllib.request.ProxyHandler({\"http\": proxy, \"https\": proxy}),\r\n  306\t                    urllib.request.HTTPSHandler(context=ctx)\r\n  307\t                )\r\n  308\t                resp = opener.open(req, timeout=CONFIG[\"request_timeout_sec\"])\r\n  309\t            else:\r\n  310\t                resp = urllib.request.urlopen(req, context=ctx, timeout=CONFIG[\"request_timeout_sec\"])\r\n  311\t            return resp.read().decode(\"utf-8\", errors=\"replace\")\r\n  312\t        except urllib.error.HTTPError as e:\r\n  313\t            if e.code == 405 and update_bl_if_needed():\r\n  314\t                reqid = int(time.time()) % 1000000\r\n  315\t                url = (\r\n  316\t                    f\"https://gemini.google.com{prefix}/_/BardChatUi/data/\"\r\n  317\t                    \"assistant.lamda.BardFrontendService/StreamGenerate\"\r\n  318\t                    f\"?bl={CONFIG['gemini_bl']}&hl=en&_reqid={reqid}&rt=c\"\r\n  319\t                )\r\n  320\t                log(\"Retrying with updated BL...\")\r\n  321\t                last_err = e\r\n  322\t                continue\r\n  323\t            last_err = e\r\n  324\t            if attempt < CONFIG[\"retry_attempts\"] - 1:\r\n  325\t                log(f\"Retry {attempt+1}/{CONFIG['retry_attempts']}: {e}\")\r\n  326\t                time.sleep(CONFIG[\"retry_delay_sec\"])\r\n  327\t        except Exception as e:\r\n  328\t            last_err = e\r\n  329\t            if attempt < CONFIG[\"retry_attempts\"] - 1:\r\n  330\t                log(f\"Retry {attempt+1}/{CONFIG['retry_attempts']}: {e}\")\r\n  331\t                time.sleep(CONFIG[\"retry_delay_sec\"])\r\n  332\t    raise last_err\r\n  333\t\r\n  334\t\r\n  335\tdef gemini_stream_generate_iter(prompt: str, model_id: int, think_mode: int, file_refs: list = None):\r\n  336\t    \"\"\"Send prompt and yield incremental text deltas using httpx streaming.\"\"\"\r\n  337\t    inner = [None] * 80\r\n  338\t    if file_refs:\r\n  339\t        refs = [[None, None, ref] for ref in file_refs]\r\n  340\t        inner[0] = [prompt, 0, None, refs, None, None, 0]\r\n  341\t    else:\r\n  342\t        inner[0] = [prompt, 0, None, None, None, None, 0]\r\n  343\t    inner[1] = [\"en\"]\r\n  344\t    inner[2] = [\"\", \"\", \"\", None, None, None, None, None, None, \"\"]\r\n  345\t    inner[6] = [0]\r\n  346\t    inner[7] = 1\r\n  347\t    inner[10] = 1\r\n  348\t    inner[11] = 0\r\n  349\t    inner[17] = [[think_mode]]\r\n  350\t    inner[18] = 0\r\n  351\t    inner[27] = 1\r\n  352\t    inner[30] = [4]\r\n  353\t    apply_chat_persistence_flags(inner)\r\n  354\t    inner[53] = 0\r\n  355\t    inner[59] = str(uuid.uuid4())\r\n  356\t    inner[61] = []\r\n  357\t    inner[68] = 1\r\n  358\t    inner[79] = model_id\r\n  359\t\r\n  360\t    outer = [None, json.dumps(inner)]\r\n  361\t    params = {\"f.req\": json.dumps(outer)}\r\n  362\t    if CONFIG.get(\"xsrf_token\"):\r\n  363\t        params[\"at\"] = CONFIG[\"xsrf_token\"]\r\n  364\t    body = urllib.parse.urlencode(params)\r\n  365\t    reqid = int(time.time()) % 1000000\r\n  366\t    prefix = account_prefix()\r\n  367\t    url = (\r\n  368\t        f\"https://gemini.google.com{prefix}/_/BardChatUi/data/\"\r\n  369\t        \"assistant.lamda.BardFrontendService/StreamGenerate\"\r\n  370\t        f\"?bl={CONFIG['gemini_bl']}&hl=en&_reqid={reqid}&rt=c\"\r\n  371\t    )\r\n  372\t    headers = {\r\n  373\t        \"Content-Type\": \"application/x-www-form-urlencoded\",\r\n  374\t        \"Origin\": \"https://gemini.google.com\",\r\n  375\t        \"Referer\": f\"https://gemini.google.com{prefix}/app\",\r\n  376\t        \"X-Same-Domain\": \"1\",\r\n  377\t        \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\",\r\n  378\t    }\r\n  379\t    if prefix:\r\n  380\t        headers[\"X-Goog-AuthUser\"] = str(CONFIG[\"auth_user\"])\r\n  381\t    cookie_str, sapisid = load_cookie()\r\n  382\t    if cookie_str:\r\n  383\t        headers[\"Cookie\"] = cookie_str\r\n  384\t    if sapisid:\r\n  385\t        headers[\"Authorization\"] = make_sapisidhash(sapisid)\r\n  386\t\r\n  387\t    proxy = CONFIG.get(\"proxy\")\r\n  388\t\r\n  389\t    if not HAS_HTTPX:\r\n  390\t        # Fallback: non-streaming with urllib\r\n  391\t        raw = gemini_stream_generate(prompt, model_id, think_mode, file_refs)\r\n  392\t        text = extract_response_text(raw)\r\n  393\t        if text:\r\n  394\t            yield text\r\n  395\t        return\r\n  396\t\r\n  397\t    prev_text = \"\"\r\n  398\t    transport = httpx.HTTPTransport(proxy=proxy) if proxy else None\r\n  399\t    with httpx.Client(transport=transport, timeout=CONFIG[\"request_timeout_sec\"], verify=True) as client:\r\n  400\t        try:\r\n  401\t            with client.stream(\"POST\", url, content=body, headers=headers) as resp:\r\n  402\t                resp.raise_for_status()\r\n  403\t                buf = \"\"\r\n  404\t                for chunk in resp.iter_text():\r\n  405\t                    buf += chunk\r\n  406\t                    if \"BardErrorInfo\" in buf:\r\n  407\t                        import re as _re\r\n  408\t                        m = _re.search(r'BardErrorInfo\\s*\\[(\\d+)\\]', buf)\r\n  409\t                        if m:\r\n  410\t                            raise RuntimeError(f\"Gemini upstream rejected request: BardErrorInfo [{m.group(1)}]\")\r\n  411\t                    while \"\\n\" in buf:\r\n  412\t                        line, buf = buf.split(\"\\n\", 1)\r\n  413\t                        if '\"wrb.fr\"' not in line or len(line) < 200:\r\n  414\t                            continue\r\n  415\t                        try:\r\n  416\t                            arr = json.loads(line)\r\n  417\t                            inner_str = arr[0][2]\r\n  418\t                            if not inner_str or len(inner_str) < 50:\r\n  419\t                                continue\r\n  420\t                            inner2 = json.loads(inner_str)\r\n  421\t                            if isinstance(inner2, list) and len(inner2) > 4 and inner2[4]:\r\n  422\t                                for part in inner2[4]:\r\n  423\t                                    if isinstance(part, list) and len(part) > 1 and part[1] and isinstance(part[1], list):\r\n  424\t                                        for t in part[1]:\r\n  425\t                                            if isinstance(t, str) and len(t) > len(prev_text):\r\n  426\t                                                delta = t[len(prev_text):]\r\n  427\t                                                delta = clean_gemini_text(delta, strip=False)\r\n  428\t                                                if delta:\r\n  429\t                                                    yield delta\r\n  430\t                                                prev_text = t\r\n  431\t                        except (json.JSONDecodeError, IndexError, TypeError):\r\n  432\t                            pass\r\n  433\t        except Exception as e:\r\n  434\t            if HAS_HTTPX and hasattr(e, 'response') and getattr(e.response, 'status_code', 0) == 405:\r\n  435\t                if update_bl_if_needed():\r\n  436\t                    log(\"BL updated, falling back to non-streaming for this request\")\r\n  437\t                    raw = gemini_stream_generate(prompt, model_id, think_mode, file_refs)\r\n  438\t                    text = extract_response_text(raw)\r\n  439\t                    if text:\r\n  440\t                        yield text\r\n  441\t                    return\r\n  442\t            raise\r\n  443\t\r\n  444\t\r\n  445\tdef clean_gemini_text(text: str, strip: bool = True) -> str:\r\n  446\t    \"\"\"Remove internal code execution artifacts.\"\"\"\r\n  447\t    text = re.sub(\r\n  448\t        r'```(?:python|javascript|text)\\?code_(?:reference|stdout)&code_event_index=\\d+\\n.*?```\\n?',\r\n  449\t        '', text, flags=re.DOTALL\r\n  450\t    )\r\n  451\t    return text.strip() if strip else text\r\n  452\t\r\n  453\t\r\n  454\tdef extract_response_text(raw: str) -> str:\r\n  455\t    \"\"\"Parse StreamGenerate response to extract final text.\"\"\"\r\n  456\t    import re as _re\r\n  457\t    bard_err = _re.search(r'BardErrorInfo\\s*\\[(\\d+)\\]', raw)\r\n  458\t    if bard_err:\r\n  459\t        raise RuntimeError(f\"Gemini upstream rejected request: BardErrorInfo [{bard_err.group(1)}]\")\r\n  460\t    texts = []\r\n  461\t    for line in raw.split(\"\\n\"):\r\n  462\t        if '\"wrb.fr\"' not in line or len(line) < 200:\r\n  463\t            continue\r\n  464\t        try:\r\n  465\t            arr = json.loads(line)\r\n  466\t            inner_str = arr[0][2]\r\n  467\t            if not inner_str or len(inner_str) < 50:\r\n  468\t                continue\r\n  469\t            inner = json.loads(inner_str)\r\n  470\t            if isinstance(inner, list) and len(inner) > 4 and inner[4]:\r\n  471\t                for part in inner[4]:\r\n  472\t                    if isinstance(part, list) and len(part) > 1 and part[1]:\r\n  473\t                        if isinstance(part[1], list):\r\n  474\t                            for t in part[1]:\r\n  475\t                                if isinstance(t, str) and len(t) > 0:\r\n  476\t                                    texts.append(t)\r\n  477\t        except (json.JSONDecodeError, IndexError, TypeError):\r\n  478\t            pass\r\n  479\t    text = \"\"\r\n  480\t    for t in reversed(texts):\r\n  481\t        if t.strip():\r\n  482\t            text = t\r\n  483\t            break\r\n  484\t    return clean_gemini_text(text)\r\n  485\t\r\n  486\t\r\n  487\t# ─── OpenAI Format Helpers ───────────────────────────────────────────────────\r\n  488\t\r\n  489\tPROMPT_MAX_BYTES = 60000\r\n  490\t\r\n  491\t\r\n  492\tdef decode_data_url(url: str):\r\n  493\t    match = re.match(r\"^data:([^;,]+)?(;base64)?,(.*)$\", url, re.DOTALL)\r\n  494\t    if not match:\r\n  495\t        return None\r\n  496\t    mime = match.group(1) or \"image/png\"\r\n  497\t    is_base64 = bool(match.group(2))\r\n  498\t    data = match.group(3)\r\n  499\t    try:\r\n  500\t        if is_base64:\r\n  501\t            return base64.b64decode(data, validate=True), mime\r\n  502\t        return urllib.parse.unquote_to_bytes(data), mime\r\n  503\t    except (ValueError, TypeError, binascii.Error):\r\n  504\t        return None\r\n  505\t\r\n  506\t\r\n  507\tdef image_from_url(url: str, mime: str = None):\r\n  508\t    if not isinstance(url, str) or not url:\r\n  509\t        return None\r\n  510\t    if url.startswith(\"data:\"):\r\n  511\t        return decode_data_url(url)\r\n  512\t    return url, mime or \"image/png\"\r\n  513\t\r\n  514\t\r\n  515\tdef image_from_part(part: dict):\r\n  516\t    part_type = part.get(\"type\")\r\n  517\t    if part_type == \"image_url\":\r\n  518\t        image_url = part.get(\"image_url\", {})\r\n  519\t        if isinstance(image_url, dict):\r\n  520\t            return image_from_url(image_url.get(\"url\"), image_url.get(\"mime_type\"))\r\n  521\t        return image_from_url(image_url)\r\n  522\t    if part_type in (\"input_image\", \"image\"):\r\n  523\t        image_url = part.get(\"image_url\") or part.get(\"url\")\r\n  524\t        if isinstance(image_url, dict):\r\n  525\t            return image_from_url(image_url.get(\"url\"), image_url.get(\"mime_type\"))\r\n  526\t        if image_url:\r\n  527\t            return image_from_url(image_url, part.get(\"mime_type\"))\r\n  528\t        image_data = part.get(\"data\") or part.get(\"base64\")\r\n  529\t        if isinstance(image_data, str):\r\n  530\t            mime = part.get(\"mime_type\") or part.get(\"media_type\") or \"image/png\"\r\n  531\t            if image_data.startswith(\"data:\"):\r\n  532\t                return decode_data_url(image_data)\r\n  533\t            try:\r\n  534\t                return base64.b64decode(image_data, validate=True), mime\r\n  535\t            except (ValueError, TypeError, binascii.Error):\r\n  536\t                return None\r\n  537\t    return None\r\n  538\t\r\n  539\t\r\n  540\tdef messages_to_prompt(messages: list, tools: list = None) -> tuple:\r\n  541\t    \"\"\"Convert OpenAI messages to (prompt_str, images_list).\"\"\"\r\n  542\t    parts = []\r\n  543\t    images = []\r\n  544\t    if tools:\r\n  545\t        tool_defs = []\r\n  546\t        for tool in tools:\r\n  547\t            fn = tool.get(\"function\", tool) if tool.get(\"type\") == \"function\" else tool\r\n  548\t            tool_defs.append({\r\n  549\t                \"name\": fn.get(\"name\", tool.get(\"name\", \"\")),\r\n  550\t                \"description\": fn.get(\"description\", tool.get(\"description\", \"\")),\r\n  551\t                \"parameters\": fn.get(\"parameters\", tool.get(\"parameters\", {})),\r\n  552\t            })\r\n  553\t        if tool_defs:\r\n  554\t            tools_json = json.dumps(tool_defs, indent=2)\r\n  555\t            if len(tools_json) > PROMPT_MAX_BYTES // 2:\r\n  556\t                slim_defs = [{\"name\": t[\"name\"], \"description\": t[\"description\"]} for t in tool_defs]\r\n  557\t                tools_json = json.dumps(slim_defs, indent=2)\r\n  558\t                log(f\"Tools block too large ({len(tool_defs)} tools), stripped parameters\")\r\n  559\t            parts.append(\r\n  560\t                \"[System instruction]: You have access to tools. \"\r\n  561\t                \"To call a tool, respond with:\\n\"\r\n  562\t                '```tool_call\\n{\"name\": \"func_name\", \"arguments\": {...}}\\n```\\n'\r\n  563\t                \"Only use tool_call blocks when needed.\\n\\n\"\r\n  564\t                f\"Available tools:\\n{tools_json}\"\r\n  565\t            )\r\n  566\t    for msg in messages:\r\n  567\t        role = msg.get(\"role\", \"user\")\r\n  568\t        content = msg.get(\"content\", \"\")\r\n  569\t        if isinstance(content, list):\r\n  570\t            text_parts = []\r\n  571\t            for c in content:\r\n  572\t                if c.get(\"type\") in (\"text\", \"input_text\", \"output_text\"):\r\n  573\t                    text_parts.append(c.get(\"text\", \"\"))\r\n  574\t                else:\r\n  575\t                    image = image_from_part(c)\r\n  576\t                    if image:\r\n  577\t                        images.append(image)\r\n  578\t                        text_parts.append(\"[Image attached]\")\r\n  579\t            content = \" \".join(text_parts)\r\n  580\t        if role == \"system\":\r\n  581\t            parts.append(f\"[System instruction]: {content}\")\r\n  582\t        elif role == \"assistant\":\r\n  583\t            if msg.get(\"tool_calls\"):\r\n  584\t                tc_strs = []\r\n  585\t                for tc in msg[\"tool_calls\"]:\r\n  586\t                    fn = tc.get(\"function\", {})\r\n  587\t                    tc_strs.append(\r\n  588\t                        f'```tool_call\\n{{\"name\": \"{fn.get(\"name\")}\", '\r\n  589\t                        f'\"arguments\": {fn.get(\"arguments\", \"{}\")}}}\\n```'\r\n  590\t                    )\r\n  591\t                parts.append(f\"[Assistant]: {content or ''}\\n\" + \"\\n\".join(tc_strs))\r\n  592\t            else:\r\n  593\t                parts.append(f\"[Assistant]: {content}\")\r\n  594\t        elif role == \"tool\":\r\n  595\t            parts.append(f\"[Tool result for {msg.get('name', '')}]: {content}\")\r\n  596\t        else:\r\n  597\t            parts.append(content if content else \"\")\r\n  598\t    return \"\\n\\n\".join(p for p in parts if p), images\r\n  599\t\r\n  600\t\r\n  601\tdef google_contents_to_prompt(req: dict) -> tuple:\r\n  602\t    \"\"\"Convert Google API contents to (prompt_str, images_list).\"\"\"\r\n  603\t    parts = []\r\n  604\t    images = []\r\n  605\t\r\n  606\t    sys_inst = req.get(\"systemInstruction\")\r\n  607\t    if sys_inst:\r\n  608\t        sys_text = \" \".join(\r\n  609\t            part.get(\"text\", \"\") for part in sys_inst.get(\"parts\", []) if part.get(\"text\")\r\n  610\t        )\r\n  611\t        if sys_text:\r\n  612\t            parts.append(f\"[System instruction]: {sys_text}\")\r\n  613\t\r\n  614\t    for content in req.get(\"contents\", []):\r\n  615\t        role = content.get(\"role\", \"user\")\r\n  616\t        text_parts = []\r\n  617\t        for part in content.get(\"parts\", []):\r\n  618\t            if part.get(\"text\"):\r\n  619\t                text_parts.append(part[\"text\"])\r\n  620\t            elif part.get(\"inlineData\"):\r\n  621\t                data = part[\"inlineData\"]\r\n  622\t                try:\r\n  623\t                    images.append((\r\n  624\t                        base64.b64decode(data[\"data\"], validate=True),\r\n  625\t                        data.get(\"mimeType\", \"image/png\"),\r\n  626\t                    ))\r\n  627\t                    text_parts.append(\"[Image attached]\")\r\n  628\t                except (KeyError, ValueError, TypeError, binascii.Error):\r\n  629\t                    pass\r\n  630\t        text = \" \".join(text_parts)\r\n  631\t        if role == \"model\":\r\n  632\t            parts.append(f\"[Assistant]: {text}\")\r\n  633\t        else:\r\n  634\t            parts.append(text)\r\n  635\t\r\n  636\t    return \"\\n\\n\".join(part for part in parts if part), images\r\n  637\t\r\n  638\t\r\n  639\tdef parse_tool_calls(text: str) -> tuple:\r\n  640\t    \"\"\"Extract tool_call blocks. Returns (clean_text, tool_calls_list).\"\"\"\r\n  641\t    tool_calls = []\r\n  642\t    pattern = r'```tool_call\\s*\\n(.*?)\\n```'\r\n  643\t    for match in re.findall(pattern, text, re.DOTALL):\r\n  644\t        try:\r\n  645\t            data = json.loads(match.strip())\r\n  646\t            tool_calls.append({\r\n  647\t                \"id\": f\"call_{uuid.uuid4().hex[:8]}\",\r\n  648\t                \"type\": \"function\",\r\n  649\t                \"function\": {\r\n  650\t                    \"name\": data[\"name\"],\r\n  651\t                    \"arguments\": json.dumps(data.get(\"arguments\", {}), ensure_ascii=False),\r\n  652\t                },\r\n  653\t            })\r\n  654\t        except (json.JSONDecodeError, KeyError):\r\n  655\t            pass\r\n  656\t    clean = re.sub(pattern, '', text, flags=re.DOTALL).strip()\r\n  657\t    return clean, tool_calls\r\n  658\t\r\n  659\t\r\n  660\t# ─── HTTP Handler ────────────────────────────────────────────────────────────\r\n  661\t\r\n  662\tclass GeminiHandler(BaseHTTPRequestHandler):\r\n  663\t    def log_message(self, fmt, *args):\r\n  664\t        client_ip = self.client_address[0] if self.client_address else \"-\"\r\n  665\t        log(f\"{client_ip} {fmt % args}\")\r\n  666\t\r\n  667\t    def send_json(self, data, status=200):\r\n  668\t        body = json.dumps(data, ensure_ascii=False).encode()\r\n  669\t        self.send_response(status)\r\n  670\t        self.send_header(\"Content-Type\", \"application/json\")\r\n  671\t        self.send_header(\"Access-Control-Allow-Origin\", \"*\")\r\n  672\t        self.send_header(\"Content-Length\", str(len(body)))\r\n  673\t        self.end_headers()\r\n  674\t        self.wfile.write(body)\r\n  675\t\r\n  676\t    def _authorized(self):\r\n  677\t        keys = CONFIG.get(\"api_keys\") or []\r\n  678\t        if not keys:\r\n  679\t            return True\r\n  680\t        # Authorization: Bearer <key>\r\n  681\t        auth = self.headers.get(\"Authorization\", \"\")\r\n  682\t        if auth.startswith(\"Bearer \") and auth[7:] in keys:\r\n  683\t            return True\r\n  684\t        # header keys (OpenAI x-api-key / Google x-goog-api-key)\r\n  685\t        for h in (\"x-api-key\", \"x-goog-api-key\"):\r\n  686\t            if self.headers.get(h, \"\") in keys:\r\n  687\t                return True\r\n  688\t        # query param ?key= (Gemini CLI native style)\r\n  689\t        if \"?\" in self.path:\r\n  690\t            for pair in self.path.split(\"?\", 1)[1].split(\"&\"):\r\n  691\t                if pair.startswith(\"key=\") and pair[4:] in keys:\r\n  692\t                    return True\r\n  693\t        return False\r\n  694\t\r\n  695\t    def do_OPTIONS(self):\r\n  696\t        self.send_response(204)\r\n  697\t        self.send_header(\"Access-Control-Allow-Origin\", \"*\")\r\n  698\t        self.send_header(\"Access-Control-Allow-Methods\", \"GET, POST, OPTIONS\")\r\n  699\t        self.send_header(\"Access-Control-Allow-Headers\", \"*\")\r\n  700\t        self.end_headers()\r\n  701\t\r\n  702\t    def do_GET(self):\r\n  703\t        try:\r\n  704\t            if self.path.startswith(\"/v1\") and not self._authorized():\r\n  705\t                self.send_json({\"error\": {\"message\": \"invalid api key\"}}, 401)\r\n  706\t                return\r\n  707\t            if self.path == \"/v1/models\":\r\n  708\t                self.send_json({\"object\": \"list\", \"data\": [\r\n  709\t                    {\"id\": n, \"object\": \"model\", \"created\": 1700000000,\r\n  710\t                     \"owned_by\": \"google\", \"description\": c[\"desc\"]}\r\n  711\t                    for n, c in MODELS.items()\r\n  712\t                ]})\r\n  713\t            elif self.path.startswith(\"/v1beta/models\"):\r\n  714\t                self._handle_google_models_list()\r\n  715\t            elif self.path == \"/\":\r\n  716\t                self.send_json({\"status\": \"ok\", \"version\": __version__,\r\n  717\t                                \"models\": list(MODELS.keys())})\r\n  718\t            else:\r\n  719\t                self.send_json({\"error\": \"not found\"}, 404)\r\n  720\t        except (BrokenPipeError, ConnectionResetError):\r\n  721\t            pass\r\n  722\t        except Exception as e:\r\n  723\t            log(f\"GET error: {e}\")\r\n  724\t\r\n  725\t    def do_POST(self):\r\n  726\t        try:\r\n  727\t            if self.path.startswith(\"/v1\") and not self._authorized():\r\n  728\t                self.send_json({\"error\": {\"message\": \"invalid api key\"}}, 401)\r\n  729\t                return\r\n  730\t            body = self._read_request_body()\r\n  731\t            if self.path == \"/v1/chat/completions\":\r\n  732\t                self.handle_chat(body)\r\n  733\t            elif self.path == \"/v1/responses\":\r\n  734\t                self.handle_responses(body)\r\n  735\t            elif \":streamGenerateContent\" in self.path:\r\n  736\t                self._handle_google_generate(body, stream=True)\r\n  737\t            elif \":generateContent\" in self.path:\r\n  738\t                self._handle_google_generate(body, stream=False)\r\n  739\t            else:\r\n  740\t                self.send_json({\"error\": \"not found\"}, 404)\r\n  741\t        except (BrokenPipeError, ConnectionResetError):\r\n  742\t            pass\r\n  743\t        except Exception as e:\r\n  744\t            log(f\"POST error: {e}\")\r\n  745\t            try:\r\n  746\t                self.send_json({\"error\": {\"message\": str(e)}}, 500)\r\n  747\t            except:\r\n  748\t                pass\r\n  749\t\r\n  750\t    def _read_request_body(self) -> bytes:\r\n  751\t        transfer_encoding = self.headers.get(\"Transfer-Encoding\", \"\")\r\n  752\t        if \"chunked\" in transfer_encoding.lower():\r\n  753\t            chunks = []\r\n  754\t            while True:\r\n  755\t                size_line = self.rfile.readline()\r\n  756\t                if not size_line:\r\n  757\t                    break\r\n  758\t                size_text = size_line.split(b\";\", 1)[0].strip()\r\n  759\t                try:\r\n  760\t                    size = int(size_text, 16)\r\n  761\t                except ValueError:\r\n  762\t                    raise ValueError(\"invalid chunked request body\")\r\n  763\t                if size == 0:\r\n  764\t                    while True:\r\n  765\t                        trailer = self.rfile.readline()\r\n  766\t                        if trailer in (b\"\\r\\n\", b\"\\n\", b\"\"):\r\n  767\t                            break\r\n  768\t                    break\r\n  769\t                chunks.append(self.rfile.read(size))\r\n  770\t                self.rfile.read(2)\r\n  771\t            return b\"\".join(chunks)\r\n  772\t\r\n  773\t        length = int(self.headers.get(\"Content-Length\", 0))\r\n  774\t        return self.rfile.read(length) if length else b\"\"\r\n  775\t\r\n  776\t    def _resolve_model(self, model_name):\r\n  777\t        think_override = None\r\n  778\t        if \"@think=\" in model_name:\r\n  779\t            model_name, think_str = model_name.rsplit(\"@think=\", 1)\r\n  780\t            think_override = int(think_str)\r\n  781\t        cfg = MODELS.get(model_name)\r\n  782\t        if not cfg:\r\n  783\t            return None, None, None, f\"Unknown model: {model_name}\"\r\n  784\t        return model_name, cfg[\"mode\"], (think_override if think_override is not None else cfg[\"think\"]), None\r\n  785\t\r\n  786\t    def _call_gemini(self, prompt, model_id, think_mode, tools, file_refs=None):\r\n  787\t        raw = gemini_stream_generate(prompt, model_id, think_mode, file_refs)\r\n  788\t        text = extract_response_text(raw)\r\n  789\t        tool_calls = None\r\n  790\t        if tools and text:\r\n  791\t            text, tool_calls = parse_tool_calls(text)\r\n  792\t        return text or \"\", tool_calls\r\n  793\t\r\n  794\t    def handle_chat(self, body: bytes):\r\n  795\t        req = json.loads(body)\r\n  796\t        model_name, model_id, think_mode, err = self._resolve_model(\r\n  797\t            req.get(\"model\", CONFIG[\"default_model\"]))\r\n  798\t        if err:\r\n  799\t            self.send_json({\"error\": {\"message\": err}}, 400)\r\n  800\t            return\r\n  801\t\r\n  802\t        tools = req.get(\"tools\")\r\n  803\t        prompt, images = messages_to_prompt(req.get(\"messages\", []), tools)\r\n  804\t        if not prompt.strip():\r\n  805\t            self.send_json({\"error\": {\"message\": \"empty prompt\"}}, 400)\r\n  806\t            return\r\n  807\t\r\n  808\t        stream = req.get(\"stream\", False)\r\n  809\t        cid = f\"chatcmpl-{uuid.uuid4().hex[:12]}\"\r\n  810\t        try:\r\n  811\t            file_refs = upload_images(images)\r\n  812\t        except RuntimeError as e:\r\n  813\t            self.send_json({\"error\": {\"message\": f\"upstream error: {e}\"}}, 502)\r\n  814\t            return\r\n  815\t\r\n  816\t        if stream and not tools:\r\n  817\t            # True streaming: forward chunks as they arrive\r\n  818\t            try:\r\n  819\t                self.send_response(200)\r\n  820\t                self.send_header(\"Content-Type\", \"text/event-stream\")\r\n  821\t                self.send_header(\"Cache-Control\", \"no-cache\")\r\n  822\t                self.send_header(\"Access-Control-Allow-Origin\", \"*\")\r\n  823\t                self.end_headers()\r\n  824\t                first_chunk = {\"id\": cid, \"object\": \"chat.completion.chunk\", \"created\": int(time.time()),\r\n  825\t                               \"model\": model_name, \"choices\": [{\"index\": 0, \"delta\": {\"role\": \"assistant\"}, \"finish_reason\": None}]}\r\n  826\t                self.wfile.write(f\"data: {json.dumps(first_chunk)}\\n\\n\".encode())\r\n  827\t                for delta_text in gemini_stream_generate_iter(prompt, model_id, think_mode, file_refs):\r\n  828\t                    chunk = {\"id\": cid, \"object\": \"chat.completion.chunk\", \"created\": int(time.time()),\r\n  829\t                             \"model\": model_name, \"choices\": [{\"index\": 0, \"delta\": {\"content\": delta_text}, \"finish_reason\": None}]}\r\n  830\t                    self.wfile.write(f\"data: {json.dumps(chunk, ensure_ascii=False)}\\n\\n\".encode())\r\n  831\t                    self.wfile.flush()\r\n  832\t                # Final chunk\r\n  833\t                chunk = {\"id\": cid, \"object\": \"chat.completion.chunk\", \"created\": int(time.time()),\r\n  834\t                         \"model\": model_name, \"choices\": [{\"index\": 0, \"delta\": {}, \"finish_reason\": \"stop\"}]}\r\n  835\t                self.wfile.write(f\"data: {json.dumps(chunk)}\\n\\n\".encode())\r\n  836\t                self.wfile.write(b\"data: [DONE]\\n\\n\")\r\n  837\t                self.wfile.flush()\r\n  838\t            except (BrokenPipeError, ConnectionResetError):\r\n  839\t                pass\r\n  840\t            except Exception as e:\r\n  841\t                log(f\"Stream error: {e}\")\r\n  842\t            return\r\n  843\t\r\n  844\t        # Non-streaming (or tool calling which needs full response)\r\n  845\t        try:\r\n  846\t            text, tool_calls = self._call_gemini(prompt, model_id, think_mode, tools, file_refs)\r\n  847\t        except Exception as e:\r\n  848\t            self.send_json({\"error\": {\"message\": f\"upstream error: {e}\"}}, 502)\r\n  849\t            return\r\n  850\t\r\n  851\t        msg = {\"role\": \"assistant\", \"content\": text or None}\r\n  852\t        if tool_calls:\r\n  853\t            msg[\"tool_calls\"] = tool_calls\r\n  854\t        finish = \"tool_calls\" if tool_calls else \"stop\"\r\n  855\t\r\n  856\t        if stream:\r\n  857\t            # Stream mode with tools: send as single chunk (need full parse for tool_calls)\r\n  858\t            self.send_response(200)\r\n  859\t            self.send_header(\"Content-Type\", \"text/event-stream\")\r\n  860\t            self.send_header(\"Cache-Control\", \"no-cache\")\r\n  861\t            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\r\n  862\t            self.end_headers()\r\n  863\t            chunk = {\"id\": cid, \"object\": \"chat.completion.chunk\", \"created\": int(time.time()),\r\n  864\t                     \"model\": model_name, \"choices\": [{\"index\": 0, \"delta\": msg, \"finish_reason\": finish}]}\r\n  865\t            self.wfile.write(f\"data: {json.dumps(chunk, ensure_ascii=False)}\\n\\n\".encode())\r\n  866\t            self.wfile.write(b\"data: [DONE]\\n\\n\")\r\n  867\t            self.wfile.flush()\r\n  868\t        else:\r\n  869\t            self.send_json({\r\n  870\t                \"id\": cid, \"object\": \"chat.completion\", \"created\": int(time.time()),\r\n  871\t                \"model\": model_name,\r\n  872\t                \"choices\": [{\"index\": 0, \"message\": msg, \"finish_reason\": finish}],\r\n  873\t                \"usage\": {\"prompt_tokens\": len(prompt)//4, \"completion_tokens\": len(text)//4,\r\n  874\t                          \"total_tokens\": (len(prompt)+len(text))//4},\r\n  875\t            })\r\n  876\t\r\n  877\t    def handle_responses(self, body: bytes):\r\n  878\t        \"\"\"OpenAI Responses API for Codex CLI compatibility.\"\"\"\r\n  879\t        req = json.loads(body)\r\n  880\t        model_name, model_id, think_mode, err = self._resolve_model(\r\n  881\t            req.get(\"model\", CONFIG[\"default_model\"]))\r\n  882\t        if err:\r\n  883\t            self.send_json({\"error\": {\"message\": err}}, 400)\r\n  884\t            return\r\n  885\t\r\n  886\t        input_items = req.get(\"input\", [])\r\n  887\t        tools = req.get(\"tools\")\r\n  888\t\r\n  889\t        messages = []\r\n  890\t        if req.get(\"instructions\"):\r\n  891\t            messages.append({\"role\": \"system\", \"content\": req[\"instructions\"]})\r\n  892\t        if isinstance(input_items, str):\r\n  893\t            messages.append({\"role\": \"user\", \"content\": input_items})\r\n  894\t        elif isinstance(input_items, list):\r\n  895\t            for item in input_items:\r\n  896\t                if isinstance(item, str):\r\n  897\t                    messages.append({\"role\": \"user\", \"content\": item})\r\n  898\t                elif isinstance(item, dict):\r\n  899\t                    if item.get(\"type\") == \"function_call_output\":\r\n  900\t                        messages.append({\"role\": \"tool\", \"tool_call_id\": item.get(\"call_id\", \"\"),\r\n  901\t                                         \"name\": item.get(\"name\", \"\"), \"content\": item.get(\"output\", \"\")})\r\n  902\t                    elif item.get(\"type\") in (\"input_text\", \"input_image\", \"image\"):\r\n  903\t                        messages.append({\"role\": \"user\", \"content\": [item]})\r\n  904\t                    elif item.get(\"role\") == \"assistant\" or (item.get(\"type\") == \"message\" and item.get(\"role\") == \"assistant\"):\r\n  905\t                        cp = item.get(\"content\", [])\r\n  906\t                        text_acc, tc_list = \"\", []\r\n  907\t                        if isinstance(cp, list):\r\n  908\t                            for c in cp:\r\n  909\t                                if isinstance(c, dict):\r\n  910\t                                    if c.get(\"type\") == \"output_text\": text_acc += c.get(\"text\", \"\")\r\n  911\t                                    elif c.get(\"type\") == \"function_call\": tc_list.append(c)\r\n  912\t                        elif isinstance(cp, str):\r\n  913\t                            text_acc = cp\r\n  914\t                        m = {\"role\": \"assistant\", \"content\": text_acc or None}\r\n  915\t                        if tc_list:\r\n  916\t                            m[\"tool_calls\"] = [{\"id\": tc.get(\"call_id\", f\"call_{i}\"), \"type\": \"function\",\r\n  917\t                                                \"function\": {\"name\": tc.get(\"name\",\"\"), \"arguments\": tc.get(\"arguments\",\"{}\")}}\r\n  918\t                                               for i, tc in enumerate(tc_list)]\r\n  919\t                        messages.append(m)\r\n  920\t                    else:\r\n  921\t                        role = item.get(\"role\", \"user\")\r\n  922\t                        messages.append({\"role\": role, \"content\": item.get(\"content\", \"\")})\r\n  923\t\r\n  924\t        if tools:\r\n  925\t            tools = [{\"type\": \"function\", \"function\": {\"name\": t[\"name\"], \"description\": t.get(\"description\", \"\"), \"parameters\": t.get(\"parameters\", {})}}\r\n  926\t                     if t.get(\"type\") == \"function\" and \"function\" not in t else t for t in tools]\r\n  927\t\r\n  928\t        prompt, images = messages_to_prompt(messages, tools)\r\n  929\t        if not prompt.strip():\r\n  930\t            self.send_json({\"error\": {\"message\": \"empty input\"}}, 400)\r\n  931\t            return\r\n  932\t\r\n  933\t        try:\r\n  934\t            file_refs = upload_images(images)\r\n  935\t            text, tool_calls = self._call_gemini(prompt, model_id, think_mode, tools, file_refs)\r\n  936\t        except Exception as e:\r\n  937\t            self.send_json({\"error\": {\"message\": f\"upstream error: {e}\"}}, 502)\r\n  938\t            return\r\n  939\t\r\n  940\t        rid = f\"resp_{uuid.uuid4().hex[:16]}\"\r\n  941\t        mid = f\"msg_{uuid.uuid4().hex[:12]}\"\r\n  942\t        output = []\r\n  943\t        if tool_calls:\r\n  944\t            for tc in tool_calls:\r\n  945\t                output.append({\"type\": \"function_call\", \"id\": tc[\"id\"], \"call_id\": tc[\"id\"],\r\n  946\t                               \"name\": tc[\"function\"][\"name\"], \"arguments\": tc[\"function\"][\"arguments\"], \"status\": \"completed\"})\r\n  947\t        if text or not tool_calls:\r\n  948\t            output.append({\"type\": \"message\", \"id\": mid, \"role\": \"assistant\", \"status\": \"completed\",\r\n  949\t                           \"content\": [{\"type\": \"output_text\", \"text\": text or \"\", \"annotations\": []}]})\r\n  950\t\r\n  951\t        if req.get(\"stream\"):\r\n  952\t            self.send_response(200)\r\n  953\t            self.send_header(\"Content-Type\", \"text/event-stream\")\r\n  954\t            self.send_header(\"Cache-Control\", \"no-cache\")\r\n  955\t            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\r\n  956\t            self.end_headers()\r\n  957\t            seq = [0]\r\n  958\t\r\n  959\t            def emit(ev_type, **fields):\r\n  960\t                seq[0] += 1\r\n  961\t                ev = {\"type\": ev_type, \"sequence_number\": seq[0], **fields}\r\n  962\t                self.wfile.write(f\"event: {ev_type}\\ndata: {json.dumps(ev)}\\n\\n\".encode())\r\n  963\t\r\n  964\t            usage = {\"input_tokens\": len(prompt)//4, \"output_tokens\": len(text)//4, \"total_tokens\": (len(prompt)+len(text))//4}\r\n  965\t            base_resp = {\"id\": rid, \"object\": \"response\", \"created_at\": int(time.time()), \"model\": model_name}\r\n  966\t            emit(\"response.created\", response={**base_resp, \"status\": \"in_progress\", \"output\": [], \"usage\": None})\r\n  967\t            emit(\"response.in_progress\", response={**base_resp, \"status\": \"in_progress\", \"output\": [], \"usage\": None})\r\n  968\t            for oi, item in enumerate(output):\r\n  969\t                if item[\"type\"] == \"function_call\":\r\n  970\t                    pending = {\"type\": \"function_call\", \"id\": item[\"id\"], \"call_id\": item[\"call_id\"],\r\n  971\t                               \"name\": item[\"name\"], \"arguments\": \"\", \"status\": \"in_progress\"}\r\n  972\t                    emit(\"response.output_item.added\", output_index=oi, item=pending)\r\n  973\t                    emit(\"response.function_call_arguments.delta\", item_id=item[\"id\"], output_index=oi, delta=item[\"arguments\"])\r\n  974\t                    emit(\"response.function_call_arguments.done\", item_id=item[\"id\"], output_index=oi, arguments=item[\"arguments\"])\r\n  975\t                    emit(\"response.output_item.done\", output_index=oi, item=item)\r\n  976\t                elif item[\"type\"] == \"message\":\r\n  977\t                    pending = {\"type\": \"message\", \"id\": item[\"id\"], \"role\": \"assistant\", \"status\": \"in_progress\", \"content\": []}\r\n  978\t                    emit(\"response.output_item.added\", output_index=oi, item=pending)\r\n  979\t                    for ci, cp in enumerate(item[\"content\"]):\r\n  980\t                        emit(\"response.content_part.added\", item_id=item[\"id\"], output_index=oi, content_index=ci,\r\n  981\t                             part={\"type\": \"output_text\", \"text\": \"\", \"annotations\": []})\r\n  982\t                        emit(\"response.output_text.delta\", item_id=item[\"id\"], output_index=oi, content_index=ci, delta=cp[\"text\"])\r\n  983\t                        emit(\"response.output_text.done\", item_id=item[\"id\"], output_index=oi, content_index=ci, text=cp[\"text\"])\r\n  984\t                        emit(\"response.content_part.done\", item_id=item[\"id\"], output_index=oi, content_index=ci, part=cp)\r\n  985\t                    emit(\"response.output_item.done\", output_index=oi, item=item)\r\n  986\t            emit(\"response.completed\", response={**base_resp, \"status\": \"completed\", \"output\": output, \"usage\": usage})\r\n  987\t            self.wfile.flush()\r\n  988\t        else:\r\n  989\t            self.send_json({\"id\": rid, \"object\": \"response\", \"created_at\": int(time.time()), \"status\": \"completed\",\r\n  990\t                            \"model\": model_name, \"output\": output,\r\n  991\t                            \"usage\": {\"input_tokens\": len(prompt)//4, \"output_tokens\": len(text)//4, \"total_tokens\": (len(prompt)+len(text))//4}})\r\n  992\t\r\n  993\t\r\n  994\t    # ─── Google Native API (Gemini CLI compatible) ────────────────────────────\r\n  995\t\r\n  996\t    def _parse_google_model_from_path(self):\r\n  997\t        \"\"\"Extract model name from /v1beta/models/{model}:method path.\"\"\"\r\n  998\t        m = re.match(r'/v1beta/models/([^:?]+)', self.path)\r\n  999\t        if m:\r\n 1000\t            return m.group(1)\r\n 1001\t        return None\r\n 1002\t\r\n 1003\t    def _handle_google_models_list(self):\r\n 1004\t        \"\"\"GET /v1beta/models — Google AI format model list.\"\"\"\r\n 1005\t        models = []\r\n 1006\t        for name, cfg in MODELS.items():\r\n 1007\t            models.append({\r\n 1008\t                \"name\": f\"models/{name}\",\r\n 1009\t                \"displayName\": name,\r\n 1010\t                \"description\": cfg[\"desc\"],\r\n 1011\t                \"supportedGenerationMethods\": [\"generateContent\", \"streamGenerateContent\"],\r\n 1012\t            })\r\n 1013\t        self.send_json({\"models\": models})\r\n 1014\t\r\n 1015\t    def _handle_google_generate(self, body: bytes, stream: bool):\r\n 1016\t        \"\"\"Handle Google native generateContent / streamGenerateContent.\"\"\"\r\n 1017\t        req = json.loads(body)\r\n 1018\t        model_name = self._parse_google_model_from_path()\r\n 1019\t        if not model_name:\r\n 1020\t            self.send_json({\"error\": {\"message\": \"model not specified in path\"}}, 400)\r\n 1021\t            return\r\n 1022\t\r\n 1023\t        model_name, model_id, think_mode, err = self._resolve_model(model_name)\r\n 1024\t        if err:\r\n 1025\t            self.send_json({\"error\": {\"message\": err}}, 400)\r\n 1026\t            return\r\n 1027\t\r\n 1028\t        prompt, images = google_contents_to_prompt(req)\r\n 1029\t        if not prompt.strip():\r\n 1030\t            self.send_json({\"error\": {\"message\": \"empty content\"}}, 400)\r\n 1031\t            return\r\n 1032\t\r\n 1033\t        try:\r\n 1034\t            file_refs = upload_images(images)\r\n 1035\t            text, _ = self._call_gemini(prompt, model_id, think_mode, None, file_refs)\r\n 1036\t        except Exception as e:\r\n 1037\t            self.send_json({\"error\": {\"message\": f\"upstream error: {e}\"}}, 502)\r\n 1038\t            return\r\n 1039\t\r\n 1040\t        candidate = {\r\n 1041\t            \"content\": {\"parts\": [{\"text\": text or \"\"}], \"role\": \"model\"},\r\n 1042\t            \"finishReason\": \"STOP\",\r\n 1043\t            \"index\": 0,\r\n 1044\t        }\r\n 1045\t        usage = {\r\n 1046\t            \"promptTokenCount\": len(prompt) // 4,\r\n 1047\t            \"candidatesTokenCount\": len(text) // 4,\r\n 1048\t            \"totalTokenCount\": (len(prompt) + len(text)) // 4,\r\n 1049\t        }\r\n 1050\t        response_obj = {\r\n 1051\t            \"candidates\": [candidate],\r\n 1052\t            \"usageMetadata\": usage,\r\n 1053\t            \"modelVersion\": model_name,\r\n 1054\t        }\r\n 1055\t\r\n 1056\t        if stream:\r\n 1057\t            self.send_response(200)\r\n 1058\t            self.send_header(\"Content-Type\", \"text/event-stream\")\r\n 1059\t            self.send_header(\"Cache-Control\", \"no-cache\")\r\n 1060\t            self.send_header(\"Access-Control-Allow-Origin\", \"*\")\r\n 1061\t            self.end_headers()\r\n 1062\t            self.wfile.write(f\"data: {json.dumps(response_obj)}\\n\\n\".encode())\r\n 1063\t            self.wfile.flush()\r\n 1064\t        else:\r\n 1065\t            self.send_json(response_obj)\r\n 1066\t\r\n 1067\t\r\n 1068\t# ─── Main ────────────────────────────────────────────────────────────────────\r\n 1069\t\r\n 1070\tdef load_config(path: str):\r\n 1071\t    if path and os.path.exists(path):\r\n 1072\t        with open(path) as f:\r\n 1073\t            CONFIG.update(json.load(f))\r\n 1074\t        log(f\"Config loaded: {path}\")\r\n 1075\t\r\n 1076\t\r\n 1077\tdef main():\r\n 1078\t    parser = argparse.ArgumentParser(description=\"Gemini Web to OpenAI API\")\r\n 1079\t    parser.add_argument(\"--port\", type=int, default=None)\r\n 1080\t    parser.add_argument(\"--config\", type=str, default=None)\r\n 1081\t    parser.add_argument(\"--cookie-file\", type=str, default=None, help=\"Path to cookie file\")\r\n 1082\t    parser.add_argument(\"--proxy\", type=str, default=None, help=\"HTTP proxy, e.g. http://127.0.0.1:7890\")\r\n 1083\t    parser.add_argument(\"--version\", action=\"version\", version=f\"gemini-web2api {__version__}\")\r\n 1084\t    args = parser.parse_args()\r\n 1085\t\r\n 1086\t    config_path = args.config or os.environ.get(\"GEMINI_WEB2API_CONFIG\")\r\n 1087\t    if not config_path:\r\n 1088\t        for p in [\"./config.json\", os.path.expanduser(\"~/.config/gemini-web2api/config.json\")]:\r\n 1089\t            if os.path.exists(p):\r\n 1090\t                config_path = p\r\n 1091\t                break\r\n 1092\t    load_config(config_path)\r\n 1093\t\r\n 1094\t    if args.port:\r\n 1095\t        CONFIG[\"port\"] = args.port\r\n 1096\t    if args.cookie_file:\r\n 1097\t        CONFIG[\"cookie_file\"] = args.cookie_file\r\n 1098\t    if args.proxy:\r\n 1099\t        CONFIG[\"proxy\"] = args.proxy\r\n 1100\t\r\n 1101\t    # Goated fork: bind the socket FIRST so the launcher's health poll passes\r\n 1102\t    # instantly; refresh gemini_bl in the background (its fetch can stall on\r\n 1103\t    # some networks, and a stale-but-valid default bl serves anonymous chat).\r\n 1104\t    def _bl_refresh():\r\n 1105\t        new_bl = fetch_latest_bl()\r\n 1106\t        if new_bl:\r\n 1107\t            CONFIG[\"gemini_bl\"] = new_bl\r\n 1108\t\r\n 1109\t    import threading\r\n 1110\t    threading.Thread(target=_bl_refresh, daemon=True).start()\r\n 1111\t\r\n 1112\t    class ThreadedServer(ThreadingMixIn, HTTPServer):\r\n 1113\t        daemon_threads = True\r\n 1114\t        allow_reuse_address = True\r\n 1115\t\r\n 1116\t    port = CONFIG[\"port\"]\r\n 1117\t    server = ThreadedServer((CONFIG[\"host\"], port), GeminiHandler)\r\n 1118\t    print(f\"gemini-web2api v{__version__}\")\r\n 1119\t    print(f\"  Listening: http://0.0.0.0:{port}\")\r\n 1120\t    print(f\"  Base URL:  http://localhost:{port}/v1\")\r\n 1121\t    print(f\"  Models:    {', '.join(MODELS.keys())}\")\r\n 1122\t    print(f\"  Cookie:    {'yes (' + CONFIG['cookie_file'] + ')' if CONFIG.get('cookie_file') else 'none (anonymous)'}\")\r\n 1123\t    print(f\"  Proxy:     {CONFIG.get('proxy') or 'none (uses system env HTTP_PROXY/HTTPS_PROXY)'}\")\r\n 1124\t    print(f\"  Retry:     {CONFIG['retry_attempts']}x / {CONFIG['retry_delay_sec']}s\")\r\n 1125\t    print(f\"  BL:        {CONFIG['gemini_bl']}\")\r\n 1126\t    print(f\"  Temporary: {'yes' if CONFIG.get('temporary_chats', False) else 'no'}\")\r\n 1127\t    print()\r\n 1128\t    try:\r\n 1129\t        server.serve_forever()\r\n 1130\t    except KeyboardInterrupt:\r\n 1131\t        print(\"\\nStopped.\")\r\n 1132\t        server.shutdown()\r\n 1133\t\r\n 1134\t\r\n 1135\tif __name__ == \"__main__\":\r\n 1136\t    main()\r\n 1137\t","toolCallId":"call_60665a7a341241e6a24850bb","name":"read"}
{"role":"tool","content":"    1\t# GAIA validation run for GoatCode (Goated-Flash-Free, zero-config).\r\n    2\t# Sample: N text-only Level-1 questions. Sequential with shared flash server.\r\n    3\timport json, subprocess, sys, time\r\n    4\tfrom pathlib import Path\r\n    5\t\r\n    6\tHERE = Path(__file__).parent\r\n    7\tN = int(sys.argv[1]) if len(sys.argv) > 1 else 10\r\n    8\tGOAT = str((HERE.parent / \"dist\" / \"goat.exe\").resolve())\r\n    9\tHOME = HERE / \".goathome\"\r\n   10\tOUT = HERE / \"results.json\"\r\n   11\t\r\n   12\trows = json.loads((HERE / \"all.json\").read_text())\r\n   13\t# text-only level 1, deterministic sample: first N by task_id sort\r\n   14\tqs = [r for r in rows if str(r[\"Level\"]) == \"1\" and not r.get(\"file_name\")]\r\n   15\tqs.sort(key=lambda r: r[\"task_id\"])\r\n   16\tqs = qs[:N]\r\n   17\tprint(f\"running {len(qs)} level-1 text-only questions\")\r\n   18\t\r\n   19\tPROMPT = (\"You are answering one GAIA benchmark question. Use your websearch and webfetch tools \"\r\n   20\t          \"to research. Think step by step. When certain, end your reply with a line exactly of the form:\\n\"\r\n   21\t          \"ANSWER: <final answer only, as short as possible>\\n\\nQuestion: {q}\\n\")\r\n   22\t\r\n   23\tresults = json.loads(OUT.read_text()) if OUT.exists() else []\r\n   24\tdone = {r[\"task_id\"] for r in results}\r\n   25\t\r\n   26\tfor i, q in enumerate(qs):\r\n   27\t    if q[\"task_id\"] in done:\r\n   28\t        continue\r\n   29\t    import os\r\n   30\t    env = dict(os.environ)\r\n   31\t    env[\"GOATCODE_HOME\"] = str(HOME.resolve())\r\n   32\t    (HERE / \"tmp\").mkdir(exist_ok=True)\r\n   33\t    HOME.mkdir(exist_ok=True)\r\n   34\t    t0 = time.time()\r\n   35\t    try:\r\n   36\t        r = subprocess.run([GOAT, \"-p\", PROMPT.format(q=q[\"Question\"])],\r\n   37\t                           capture_output=True, text=True, timeout=420, env=env,\r\n   38\t                           cwd=str(HERE), encoding=\"utf-8\", errors=\"replace\")\r\n   39\t        out = (r.stdout or \"\") + \"\\n\" + (r.stderr or \"\")\r\n   40\t    except subprocess.TimeoutExpired as e:\r\n   41\t        out = ((e.stdout or b\"\").decode(\"utf-8\", \"replace\") if isinstance(e.stdout, bytes) else (e.stdout or \"\")) + \"\\nTIMEOUT\"\r\n   42\t    elapsed = round(time.time() - t0, 1)\r\n   43\t    ans = \"\"\r\n   44\t    for line in reversed(out.splitlines()):\r\n   45\t        line = line.strip()\r\n   46\t        if line.upper().startswith(\"ANSWER:\"):\r\n   47\t            ans = line[7:].strip()\r\n   48\t            break\r\n   49\t    results.append({\"task_id\": q[\"task_id\"], \"question\": q[\"Question\"][:160],\r\n   50\t                    \"gold\": q[\"Final answer\"], \"got\": ans, \"secs\": elapsed,\r\n   51\t                    \"raw_tail\": out[-400:]})\r\n   52\t    OUT.write_text(json.dumps(results, indent=1))\r\n   53\t    print(f\"[{i+1}/{len(qs)}] {q['task_id'][:8]} {elapsed}s got={ans[:40]!r} gold={str(q['Final answer'])[:40]!r}\", flush=True)\r\n   54\t\r\n   55\tprint(\"DONE\", len(results))\r\n   56\t","toolCallId":"call_17ae7fe863f748af814105bb","name":"read"}
{"role":"tool","content":"    1\tfrom random import randint\n    2\timport time\n    3\t\n    4\tclass UhOh(Exception):\n    5\t    pass\n    6\t\n    7\tclass Hmm:\n    8\t    def __init__(self):\n    9\t        self.value = randint(-100, 100)\n   10\t\n   11\t    def Yeah(self):\n   12\t        if self.value == 0:\n   13\t            return True\n   14\t        else:\n   15\t            raise UhOh()\n   16\t\n   17\tdef Okay():\n   18\t    while True:\n   19\t        yield Hmm()\n   20\t\n   21\tdef keep_trying(go, first_try=True):\n   22\t    maybe = next(go)\n   23\t    try:\n   24\t        if maybe.Yeah():\n   25\t            return maybe.value\n   26\t    except UhOh:\n   27\t        if first_try:\n   28\t            print(\"Working...\")\n   29\t            print(\"Please wait patiently...\")\n   30\t        time.sleep(0.1)\n   31\t        return keep_trying(go, first_try=False)\n   32\t\n   33\tif __name__ == \"__main__\":\n   34\t    go = Okay()\n   35\t    print(f\"{keep_trying(go)}\")\n   36\t","toolCallId":"call_1f0c81ccf5ef4304b840e621","name":"read"}
