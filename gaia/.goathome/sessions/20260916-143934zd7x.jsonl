{"role":"tool","content":"    1\t# Wait for upstream recovery, then finish GAIA with slow, gentle rounds; score + Telegram.\n    2\timport json, os, re, subprocess, sys, time\n    3\tfrom pathlib import Path\n    4\tfrom concurrent.futures import ThreadPoolExecutor, as_completed\n    5\t\n    6\tHERE = Path(__file__).parent\n    7\tGOAT = str((HERE.parent / \"dist\" / \"goat.exe\").resolve())\n    8\tHOME = HERE / \".goathome\"\n    9\tOUT = HERE / \"results_full.json\"\n   10\tDATA = HERE / \"data\"\n   11\tSKIP_EXT = {\".mp3\", \".wav\", \".m4a\"}\n   12\tJUNK = re.compile(r\"error: LLMError|HTTP 5\\d\\d|Unable to connect|socket conne|TIMEOUT|did not start|stopped after \\d+ steps|^\\[tool \", re.I)\n   13\t\n   14\trows = json.loads((HERE / \"all.json\").read_text())\n   15\ttasks = {}\n   16\tfor r in rows:\n   17\t    fn = r.get(\"file_name\")\n   18\t    if fn and (Path(fn).suffix.lower() in SKIP_EXT or not (DATA / fn).exists()):\n   19\t        continue\n   20\t    tasks[r[\"task_id\"]] = {\"level\": int(r[\"Level\"]), \"gold\": r[\"Final answer\"],\n   21\t                           \"file\": str(DATA / fn) if fn else None, \"question\": r[\"Question\"]}\n   22\t\n   23\tres = json.loads(OUT.read_text()) if OUT.exists() else []\n   24\tclean = {x[\"task_id\"]: x for x in res if not JUNK.search(x[\"got\"])}\n   25\tprint(f\"resume: {len(clean)}/{len(tasks)} clean\", flush=True)\n   26\t\n   27\tPROMPT_TMPL = (\n   28\t    \"You are answering one GAIA benchmark question.\\n{file_note}\"\n   29\t    \"Use your websearch and webfetch tools to research facts, and bash/read tools for files.\\n\"\n   30\t    \"Think step by step and verify before concluding.\\n\"\n   31\t    \"IMPORTANT: your reply MUST end with a final line exactly of the form:\\n\"\n   32\t    \"ANSWER: <final answer only, as short as possible>\\nNever finish without that line.\\n\\n\"\n   33\t    \"Question: {q}\\n\"\n   34\t)\n   35\t\n   36\tdef extract(out):\n   37\t    lines = [l.strip() for l in out.splitlines() if l.strip()]\n   38\t    for line in reversed(lines):\n   39\t        if line.upper().startswith(\"ANSWER:\"):\n   40\t            return line[7:].strip().strip(\"*_`\").strip()\n   41\t    for line in reversed(lines):\n   42\t        if line and not line.lower().startswith((\"╭\", \"│\", \"╰\", \"ask before edits\", \"ctrl+t\", \"esc to\")):\n   43\t            return line[:200]\n   44\t    return \"\"\n   45\t\n   46\tdef invoke(prompt):\n   47\t    env = dict(os.environ)\n   48\t    env[\"GOATCODE_HOME\"] = str(HOME.resolve())\n   49\t    env[\"GOAT_MAX_STEPS\"] = \"60\"\n   50\t    t0 = time.time()\n   51\t    to = 1200 if os.environ.get(\"GAIA_BIG\") else 500\n   52\t    try:\n   53\t        r = subprocess.run([GOAT, \"-p\", prompt], capture_output=True, text=True,\n   54\t                           timeout=to, env=env, cwd=str(HERE), encoding=\"utf-8\", errors=\"replace\")\n   55\t        out = (r.stdout or \"\") + \"\\n\" + (r.stderr or \"\")\n   56\t    except subprocess.TimeoutExpired as e:\n   57\t        out = ((e.stdout or b\"\").decode(\"utf-8\", \"replace\") if isinstance(e.stdout, bytes) else (e.stdout or \"\")) + \"\\nTIMEOUT\"\n   58\t    return extract(out), round(time.time() - t0, 1), out[-300:]\n   59\t\n   60\tdef healthy():\n   61\t    ans, secs, tail = invoke(\"Reply with exactly the word: UP\")\n   62\t    return ans.upper().startswith(\"UP\") and \"LLMError\" not in ans and \"502\" not in ans\n   63\t\n   64\tFAILS = HERE / \"fails.json\"\n   65\tdef failcount():\n   66\t    try: return json.load(open(FAILS))\n   67\t    except Exception: return {}\n   68\t\n   69\tdef run_task(tid):\n   70\t    t = tasks[tid]\n   71\t    file_note = f\"A data file for this question is at: {t['file']}\\n\" if t[\"file\"] else \"\"\n   72\t    ans, secs, tail = invoke(PROMPT_TMPL.format(file_note=file_note, q=t[\"question\"]))\n   73\t    return {\"task_id\": tid, \"level\": t[\"level\"], \"file\": bool(t[\"file\"]),\n   74\t            \"question\": t[\"question\"][:200], \"gold\": t[\"gold\"], \"got\": ans, \"secs\": secs, \"raw_tail\": tail}\n   75\t\n   76\tK = 4\n   77\twhile True:\n   78\t    fc = failcount()\n   79\t    # quarantine: 2+ failures -> stop retrying (record as EXCLUDED so count can finish)\n   80\t    for tid, n in list(fc.items()):\n   81\t        if n >= 2 and tid not in clean:\n   82\t            clean[tid] = {\"task_id\": tid, \"level\": tasks[tid][\"level\"], \"file\": bool(tasks[tid][\"file\"]),\n   83\t                          \"question\": tasks[tid][\"question\"][:200], \"gold\": tasks[tid][\"gold\"],\n   84\t                          \"got\": \"EXCLUDED: timed out after repeated attempts\", \"secs\": 0,\n   85\t                          \"raw_tail\": \"excluded\"}\n   86\t            OUT.write_text(json.dumps(list(clean.values()), indent=1))\n   87\t            print(\"EXCLUDED (2 fails):\", tid[:8], flush=True)\n   88\t    todo = [tid for tid in tasks if tid not in clean]\n   89\t    if not todo:\n   90\t        break\n   91\t    # health gate: wait until upstream serves us again\n   92\t    waits = 0\n   93\t    while not healthy():\n   94\t        waits += 1\n   95\t        print(f\"upstream unhealthy, wait 10min ({waits})\", flush=True)\n   96\t        time.sleep(600)\n   97\t    # big-timeout mode after first failures for the whole tail\n   98\t    import os as _os\n   99\t    fc = failcount()\n  100\t    if any(fc.get(t, 0) >= 1 for t in todo):\n  101\t        _os.environ[\"GAIA_BIG\"] = \"1\"\n  102\t        print(\"escalated timeouts: 1200s\", flush=True)\n  103\t    else:\n  104\t        _os.environ.pop(\"GAIA_BIG\", None)\n  105\t    print(f\"healthy. {len(todo)} to go, K={K}\", flush=True)\n  106\t    batch = todo[:8]\n  107\t    with ThreadPoolExecutor(max_workers=K) as ex:\n  108\t        futs = [ex.submit(run_task, tid) for tid in batch]\n  109\t        for fut in as_completed(futs):\n  110\t            r = fut.result()\n  111\t            if JUNK.search(r[\"got\"]):\n  112\t                fc = failcount(); fc[r[\"task_id\"]] = fc.get(r[\"task_id\"], 0) + 1\n  113\t                FAILS.write_text(json.dumps(fc))\n  114\t                print(\"  junk:\", r[\"task_id\"][:8], r[\"got\"][:40], flush=True)\n  115\t            else:\n  116\t                clean[r[\"task_id\"]] = r\n  117\t                OUT.write_text(json.dumps(list(clean.values()), indent=1))\n  118\t                print(f\"  OK L{r['level']} {r['task_id'][:8]} {r['secs']}s {r['got'][:40]!r}\", flush=True)\n  119\t            time.sleep(4)\n  120\t    print(f\"progress: {len(clean)}/{len(tasks)}\", flush=True)\n  121\t\n  122\tprint(\"ALL_CLEAN\", len(clean), \"/\", len(tasks), flush=True)\n  123\tsubprocess.run([sys.executable, str(HERE / \"send_results.py\")])\n  124\t","toolCallId":"call_2617537b17a44c7499dc9ad8","name":"read"}
{"role":"tool","content":"    1\tPK\u0003\u0004\u0014\u0000\b\b\b\u0000sc\u0019W\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0018\u0000\u0000\u0000xl/drawings/drawing1.xml��]n�0\f\u0007�\u0013�\u000eU�iZ\u0018\u0013C\u0014^�N0\u000e�%n\u001b���\u000e��~�J6i{\u0001\u001em�?���nt��Db\u0013|#�\u0012\u0005z\u0015��]#\u000e�o��(8��`��F\\��n��\u00195�ϼ�\"�{^��\u0011}��ZJV=:�2\f�Ӵ\r� ��:�\t�IvVΫ�E�@\b�{ĸ�&���\u0003�\u0003���Mׄ�5\n... [11 more lines]","toolCallId":"call_052362760dc94294bf2a88f7","name":"read"}
{"role":"tool","content":"    1\t# Grade GAIA full results with upstream question_scorer + order-insensitive list compare.\n    2\timport json, re, string, sys\n    3\tfrom collections import defaultdict\n    4\t\n    5\tdef normalize(s):\n    6\t    s = (s or \"\").lower().strip()\n    7\t    punc = string.punctuation.replace(\",\", \"\").replace(\"%\", \"\")\n    8\t    s = \"\".join(c for c in s if c not in punc)\n    9\t    return re.sub(r\"\\s+\", \" \", s).strip()\n   10\t\n   11\tdef num(s):\n   12\t    s = (s or \"\").strip().rstrip(\".\")\n   13\t    try:\n   14\t        if s.endswith(\"%\"):\n   15\t            return float(s[:-1].replace(\",\", \"\")) / 100\n   16\t        return float(s.replace(\",\", \"\"))\n   17\t    except Exception:\n   18\t        return None\n   19\t\n   20\tdef score_one(pred, gold):\n   21\t    p, g = str(pred or \"\"), str(gold or \"\")\n   22\t    # numeric\n   23\t    pn, gn = num(p), num(g)\n   24\t    if gn is not None and pn is not None and abs(pn - gn) < 1e-6:\n   25\t        return True\n   26\t    # normalized string\n   27\t    if normalize(p) == normalize(g) and normalize(g):\n   28\t        return True\n   29\t    # list compare (order-insensitive when elements are comparable)\n   30\t    if \",\" in g:\n   31\t        ge = [normalize(x) for x in g.split(\",\") if normalize(x)]\n   32\t        pe = [normalize(x) for x in p.split(\",\") if normalize(x)]\n   33\t        if ge and pe and sorted(ge) == sorted(pe):\n   34\t            return True\n   35\t    return False\n   36\t\n   37\tif __name__ == \"__main__\":\n   38\t    path = sys.argv[1] if len(sys.argv) > 1 else \"results_full.json\"\n   39\t    res = json.load(open(path, encoding=\"utf-8\"))\n   40\t    by_level = defaultdict(lambda: [0, 0])\n   41\t    for x in res:\n   42\t        ok = score_one(x[\"got\"], x[\"gold\"])\n   43\t        x[\"correct\"] = ok\n   44\t        L = x.get(\"level\", 1)\n   45\t        by_level[L][0] += ok\n   46\t        by_level[L][1] += 1\n   47\t    json.dump(res, open(path, \"w\"), indent=1)\n   48\t    tot_ok = sum(v[0] for v in by_level.values())\n   49\t    tot = sum(v[1] for v in by_level.values())\n   50\t    print(\"per level:\")\n   51\t    for L in sorted(by_level):\n   52\t        ok, n = by_level[L]\n   53\t        print(f\"  L{L}: {ok}/{n} = {100*ok/n:.1f}%\")\n   54\t    print(f\"OVERALL: {tot_ok}/{tot} = {100*tot_ok/tot:.1f}%\")\n   55\t    empty = sum(1 for x in res if not x[\"got\"].strip())\n   56\t    to = sum(1 for x in res if \"TIMEOUT\" in x.get(\"raw_tail\",\"\"))\n   57\t    print(f\"empty answers: {empty} | timeouts: {to}\")\n   58\t    print()\n   59\t    print(\"--- misses ---\")\n   60\t    for x in res:\n   61\t        if not x[\"correct\"]:\n   62\t            print(f\"L{x.get('level',1)} | {x['question'][:64]!r} got={x['got'][:36]!r} gold={str(x['gold'])[:36]!r}\")\n   63\t","toolCallId":"call_727c2a741f6748aea38a08a5","name":"read"}
