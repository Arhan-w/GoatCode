{"role":"assistant","content":"","toolCalls":[{"id":"call_5dfd96814d694d4083bcaedb","name":"webfetch","arguments":{"url":"https://example.com"}},{"id":"call_648938023aab480298814375","name":"write","arguments":{"content":"def bul(x, d):\n    v = 0; b = 0\n    while True:\n        c = next(d); v |= (c & 0x7F) << b; b += 7\n        if not (c & 0x80): break\n        if b > 35: return None\n    return v\n\ndef lit(x, d):\n    out = ''\n    while True:\n        n = bul(x, d)\n        if n is None: return None\n        if n == 0: break\n        for i in range(0, n, 16):\n            x.extend(d.read(min(16, n - i)))\n        out += x.decode('latin-1')[:n]; x.delete(0, n)\n    return out\n\ndef dist(x, d):\n    out = ''\n    while True:\n        n = bul(x, d)\n        if n is None: return None\n        if n == 0: break\n        for _ in range(n):\n            lz = bul(x, d) + 3\n            di = bul(x, d)\n            if di is None or not (0 < di <= len(x)): return None\n            start = len(x) - di\n            rng = range(start, start + lz)\n            for i in range(0, n, 16):\n                x.extend(bytes(x[j] for j in rng[i:i + 16]))\n        out += x.decode('latin-1')[:n]; x.delete(0, n)\n    return out\n\ndef cat(parts):\n    res = ''\n    for s in parts:\n        if s is None: return None\n        res += s\n    return res\n\ndef blocks(x, d, n, tag, addr=None):\n    for i in range(n):\n        hdr = d.read(5)\n        if len(hdr) < 5: return 'trunc'\n        fin = hdr[0] & 1; typ = hdr[0] >> 1\n        ln = int.from_bytes(hdr[1:3], 'little')\n        if ln != 0xFFFF:\n            if typ == 0: x.extend(d.read(ln))\n            elif typ == 1:\n                if not (lit(x, d) and dist(x, d)): return 'dec err'\n            else: return 'dynamic'\n        else:\n            if typ == 0:\n                m = d.read(4)\n                L = int.from_bytes(m[:2], 'little')\n                x.extend(d.read(L))\n                if addr is not None: addr[0] = d.tell()\n                if tag: print('  stored #%d len=%d' % (i, L), flush=True)\n            elif typ == 1:\n                if not (lit(x, d) and dist(x, d)): return 'dec err'\n            else: return 'dynamic'\n        if fin: return 'ok'\n    return 'more'\n\ndef infl(x, d, tag=False, addr=None):\n    r = blocks(x, d, 8, tag, addr)\n    depth = 0\n    while r == 'more' and depth < 12:\n        depth += 1\n        x.clear()\n        r2 = blocks(x, d, 1, tag, addr)\n        if r2 != 'ok': return r2\n        res = cat([h.decode('latin-1') for h in huff[0]]) if False else None\n        res = reed(x)\n        if res is None: return 'dec err'\n        out[0] += res\n        print('  -- sub-inflate', r2, 'len', len(res), 'code', out[0].encode('cp437', 'replace').decode('utf-8', 'replace'), flush=True)\n    return r\n\ndef reed(x):\n    dl = bul(x, huff[1]) + 257\n    if dl is None or dl > 288: return None\n    il = bul(x, huff[2]) + 1\n    if il is None or il > 32: return None\n    cl = bul(x, huff[3]) + 4\n    if cl is None or cl > 19: return None\n    order = [16, 17, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]\n    codelen = {}\n    for j in range(cl):\n        v = bul(x, huff[4])\n        if v is None or v > 7: return None\n        codelen[order[j]] = v\n    codelen.setdefault(16, 0); codelen.setdefault(17, 0); codelen.setdefault(18, 0)\n    lens = {}\n    prev = 0\n    while len(lens) < dl + il:\n        sym = bul(x, huff[5])\n        if sym is None: return None\n        if sym < 16:\n            lens[len(lens)] = sym; prev = sym\n        elif sym == 16:\n            r = bul(x, huff[6])\n            if r is None: return None\n            for _ in range(3 + r): lens[len(lens)] = prev\n        else:\n            r = bul(x, huff[7 if sym == 17 else 8])\n            if r is None: return None\n            for _ in range((3 if sym == 17 else 11) + r): lens[len(lens)] = 0\n    return tables(lens)\n\ndef tables(lens):\n    bits = {}; maxlen = {}\n    for sym, ln in lens.items():\n        if ln:\n            bits[ln] = bits.get(ln, 0) + 1\n            maxlen[ln] = max(maxlen.get(ln, 0), sym)\n    if not bits: return None\n    sortedbl = sorted(bits)\n    code = 0; nxt = 0\n    huff[1] = {}\n    for bl in sortedbl:\n        code <<= bl - nxt\n        left = bits[bl] - (1 << (bl - nxt)) if nxt else bits[bl]\n        if left == 1:\n            if bl not in huff[1]: huff[1][bl] = {}\n            huff[1][bl][code] = 'end'\n            code += 1\n        else:\n            for _ in range(bits[bl]):\n                if bl not in huff[1]: huff[1][bl] = {}\n                huff[1][bl][code] = maxlen[bl]\n                code += 1\n        nxt = bl\n    for part in (2, 3, 4): huff[part] = {}\n    return 'ok'\n","path":"_reed.py"}}]}
