{"role":"tool","content":"    1\tfrom random import randint\n    2\timport time\n    3\t\n    4\tclass UhOh(Exception):\n    5\t    pass\n    6\t\n    7\tclass Hmm:\n    8\t    def __init__(self):\n    9\t        self.value = randint(-100, 100)\n   10\t\n   11\t    def Yeah(self):\n   12\t        if self.value == 0:\n   13\t            return True\n   14\t        else:\n   15\t            raise UhOh()\n   16\t\n   17\tdef Okay():\n   18\t    while True:\n   19\t        yield Hmm()\n   20\t\n   21\tdef keep_trying(go, first_try=True):\n   22\t    maybe = next(go)\n   23\t    try:\n   24\t        if maybe.Yeah():\n   25\t            return maybe.value\n   26\t    except UhOh:\n   27\t        if first_try:\n   28\t            print(\"Working...\")\n   29\t            print(\"Please wait patiently...\")\n   30\t        time.sleep(0.1)\n   31\t        return keep_trying(go, first_try=False)\n   32\t\n   33\tif __name__ == \"__main__\":\n   34\t    go = Okay()\n   35\t    print(f\"{keep_trying(go)}\")\n   36\t","toolCallId":"call_099a60b8bf984fe187ee10fc","name":"read"}
{"role":"tool","content":"    1\t# Upstream GAIA question_scorer (bug-for-bug: \"3,676\" parses as a 2-element list).\n    2\timport re\n    3\timport string\n    4\t\n    5\t\n    6\tdef normalize_str(input_str, remove_punct=True):\n    7\t    if remove_punct:\n    8\t        no_punct_chars = string.punctuation.replace(\"%\", \"\")\n    9\t        input_str = \"\".join(c for c in input_str.lower() if c not in no_punct_chars)\n   10\t    return re.sub(r\"\\s+\", \" \", input_str).strip()\n   11\t\n   12\t\n   13\tdef normalize_number(pred: str, gold: str):\n   14\t    if pred.endswith(\"%\"):\n   15\t        pred = pred.split(\"%\")[0]\n   16\t        pred = float(pred.replace(\",\", \"\")) / 100\n   17\t    if gold.endswith(\"%\"):\n   18\t        gold = gold.split(\"%\")[0]\n   19\t        gold = float(gold.replace(\",\", \"\")) / 100\n   20\t    return pred, gold\n   21\t\n   22\t\n   23\tdef remove_prefix(input_str, prefix):\n   24\t    if prefix.lower() + \".\" in input_str.lower():\n   25\t        return re.sub(f\"^{prefix.lower()}\\.\", \"\", input_str.lower(), flags=re.IGNORECASE)\n   26\t    return input_str\n   27\t\n   28\t\n   29\tdef is_divisible_by_eight(gold):\n   30\t    return bool(re.match(r\"^\\d+$\", gold)) and int(gold) % 8 == 0\n   31\t\n   32\t\n   33\tdef split_by_comma(s):\n   34\t    m = re.search(r\"^([a-zA-Z])+(?:,|$)\", s)\n   35\t    if m:\n   36\t        opener = m.group()\n   37\t        s = opener.join(s.split(\",\"))\n   38\t    return s\n   39\t\n   40\t\n   41\tdef question_scorer(model_answer: str, gold_answer: str) -> bool:\n   42\t    try:\n   43\t        float(gold_answer)\n   44\t        is_number = True\n   45\t    except Exception:\n   46\t        is_number = False\n   47\t\n   48\t    model_answer = remove_prefix(model_answer, \"Final Answer\")\n   49\t    model_answer = model_answer.replace(\", \", \"\")\n   50\t    try:\n   51\t        return float(model_answer) == float(gold_answer)\n   52\t    except Exception:\n   53\t        pass\n   54\t\n   55\t    try:\n   56\t        return any(float(x) == float(gold_answer) for x in model_answer.split(\" \") if x)\n   57\t    except Exception:\n   58\t        pass\n   59\t\n   60\t    y_n = (\"yes\", \"no\")\n   61\t    is_y_n = any(norm in normalize_str(gold_answer) for norm in y_n) and len(gold_answer) < 20\n   62\t\n   63\t    is_list = \",\" in gold_answer\n   64\t\n   65\t    model_answer = normalize_str(model_answer)\n   66\t    gold_answer = normalize_str(gold_answer)\n   67\t\n   68\t    if is_number:\n   69\t        model_answer, gold_answer = normalize_number(model_answer, gold_answer)\n   70\t    elif is_list:\n   71\t        model_answer = split_by_comma(model_answer)\n   72\t        gold_answer = split_by_comma(gold_answer)\n   73\t    elif not is_y_n:\n   74\t        # drop articles\n   75\t        pass\n   76\t\n   77\t    if model_answer != gold_answer:\n   78\t        return False\n   79\t    return True\n   80\t","toolCallId":"call_b9ba015b862c4aa3bf232570","name":"read"}
{"role":"tool","content":"    1\t# Watchdog: ensures the GAIA finisher keeps running until all 162 are answered,\n    2\t# and that results get sent to Telegram at the end. Run every ~10 min via cron.\n    3\timport json, os, re, subprocess, sys, time\n    4\tfrom pathlib import Path\n    5\t\n    6\tHERE = Path(\"D:/GoatCode-ts/gaia\")\n    7\tJUNK = re.compile(r\"error: LLMError|HTTP 5\\d\\d|Unable to connect|socket conne|TIMEOUT|did not start|stopped after \\d+ steps|^\\[tool \", re.I)\n    8\t\n    9\tdef clean_count():\n   10\t    try:\n   11\t        r = json.load(open(HERE / \"results_full.json\"))\n   12\t        return sum(1 for x in r if not JUNK.search(x[\"got\"]))\n   13\t    except Exception:\n   14\t        return 0\n   15\t\n   16\tn = clean_count()\n   17\tprint(\"clean:\", n, \"/162\")\n   18\tif n >= 162:\n   19\t    # ensure the send happened (idempotent marker)\n   20\t    if not (HERE / \".sent\").exists():\n   21\t        p = subprocess.run([sys.executable, str(HERE / \"send_results.py\")], capture_output=True, text=True, cwd=str(HERE))\n   22\t        print(p.stdout[-400:])\n   23\t        (HERE / \".sent\").write_text(\"ok\")\n   24\t    sys.exit(0)\n   25\t\n   26\t# is a finisher alive?\n   27\tr = subprocess.run([\"powershell\", \"-NoProfile\", \"-Command\",\n   28\t                    \"Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like '*finisher.py*' } | Select-Object -ExpandProperty ProcessId\"],\n   29\t                   capture_output=True, text=True)\n   30\tpids = [p for p in r.stdout.split() if p.strip().isdigit()]\n   31\tif pids:\n   32\t    print(\"finisher alive:\", pids)\n   33\telse:\n   34\t    print(\"restart finisher\")\n   35\t    log = open(HERE / \"finisher.log\", \"a\")\n   36\t    subprocess.Popen([sys.executable, str(HERE / \"finisher.py\")], cwd=str(HERE),\n   37\t                     stdout=log, stderr=subprocess.STDOUT)\n   38\t","toolCallId":"call_744808e58e5f48ed8c467225","name":"read"}
