{"role":"tool","content":"    1\t# Score full GAIA results and send leaderboard to Telegram (Goated, 6201806207).\n    2\timport json, subprocess, sys\n    3\tfrom pathlib import Path\n    4\tfrom score_full import score_one\n    5\t\n    6\tHERE = Path(__file__).parent\n    7\tENV = Path.home() / \"AppData/Local/hermes/.env\"\n    8\tCHAT = \"6201806207\"\n    9\t\n   10\ttoken = \"\"\n   11\tfor line in ENV.read_text(encoding=\"utf-8\", errors=\"replace\").splitlines():\n   12\t    if line.startswith(\"TELEGRAM_BOT_TOKEN=\"):\n   13\t        token = line.split(\"=\", 1)[1].strip()\n   14\t\n   15\tres = json.load(open(HERE / \"results_full.json\", encoding=\"utf-8\"))\n   16\tby = {1: [0, 0], 2: [0, 0], 3: [0, 0]}\n   17\tfor x in res:\n   18\t    ok = score_one(x[\"got\"], x[\"gold\"])\n   19\t    x[\"correct\"] = ok\n   20\t    if x[\"level\"] in by:\n   21\t        by[x[\"level\"]][1] += 1\n   22\t        by[x[\"level\"]][0] += ok\n   23\tjson.dump(res, open(HERE / \"results_full.json\", \"w\"), indent=1)\n   24\t\n   25\ttok = sum(v[1] for v in by.values()); ok_t = sum(v[0] for v in by.values())\n   26\tlines = [\n   27\t    \"GOATCODE × GAIA — FINAL RESULTS\",\n   28\t    \"Model: free-tier auto-router via FreeLLMAPI proxy ($0) + Goated-Flash-Free fallback · tools: websearch/webfetch/bash/files\",\n   29\t    \"\",\n   30\t    f\"L1: {by[1][0]}/{by[1][1]} = {100*by[1][0]/max(1,by[1][1]):.1f}%\",\n   31\t    f\"L2: {by[2][0]}/{by[2][1]} = {100*by[2][0]/max(1,by[2][1]):.1f}%\",\n   32\t    f\"L3: {by[3][0]}/{by[3][1]} = {100*by[3][0]/max(1,by[3][1]):.1f}%\",\n   33\t    f\"OVERALL: {ok_t}/{tok} = {100*ok_t/max(1,tok):.1f}%\",\n   34\t    \"\",\n   35\t    \"LEADERBOARD (GAIA val, published numbers)\",\n   36\t    \"HAL Claude Sonnet 4.5 .... 74.6% ($178)\",\n   37\t    \"HAL Sonnet 4.5 High ...... 70.9% ($180)\",\n   38\t    \"HF OpenDR GPT-5 .......... 62.8% ($360)\",\n   39\t    \"HAL o4-mini .............. 58.2% ($73)\",\n   40\t    \"HAL Gemini 2.0 Flash ..... 32.7% ($7.8)\",\n   41\t    \"Bare frontier models ..... 45-52%\",\n   42\t    \"GPT-4+plugins (2023) ..... 15%\",\n   43\t    \"Human baseline ........... 92%\",\n   44\t    \"\",\n   45\t    f\"*GoatCode free tier ...... {100*ok_t/max(1,tok):.1f}% ($0.00)*\",\n   46\t]\n   47\tmsg = \"\\n\".join(lines)\n   48\tprint(msg)\n   49\tif token:\n   50\t    r = subprocess.run([\"curl\", \"-s\", \"-X\", \"POST\", f\"https://api.telegram.org/bot{token}/sendMessage\",\n   51\t                        \"-d\", f\"chat_id={CHAT}\", \"--data-urlencode\", f\"text={msg}\",\n   52\t                        \"-o\", \"/dev/null\", \"-w\", \"%{http_code}\"], capture_output=True, text=True)\n   53\t    print(\"TELEGRAM:\", r.stdout.strip() or r.stderr[:120])\n   54\telse:\n   55\t    print(\"NO TOKEN\")\n   56\t","toolCallId":"call_c5905c7c16f54209829380bf","name":"read"}
