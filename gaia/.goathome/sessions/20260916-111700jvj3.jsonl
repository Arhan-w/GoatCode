{"role":"tool","content":"    1\t# GAIA completion runner: parallel GoatCode workers, fail-fast rounds, requeue 502s.\n    2\timport json, os, subprocess, sys, time\n    3\tfrom pathlib import Path\n    4\tfrom concurrent.futures import ThreadPoolExecutor, as_completed\n    5\t\n    6\tHERE = Path(__file__).parent\n    7\tGOAT = str((HERE.parent / \"dist\" / \"goat.exe\").resolve())\n    8\tHOME = HERE / \".goathome\"\n    9\tOUT = HERE / \"results_full.json\"\n   10\tDATA = HERE / \"data\"\n   11\tK = int(sys.argv[1]) if len(sys.argv) > 1 else 3     # parallel workers\n   12\tROUNDS = int(sys.argv[2]) if len(sys.argv) > 2 else 12\n   13\tSKIP_EXT = {\".mp3\", \".wav\", \".m4a\"}\n   14\t\n   15\trows = json.loads((HERE / \"all.json\").read_text())\n   16\ttasks = {}\n   17\tfor r in rows:\n   18\t    fn = r.get(\"file_name\")\n   19\t    if fn and (Path(fn).suffix.lower() in SKIP_EXT or not (DATA / fn).exists()):\n   20\t        continue\n   21\t    tasks[r[\"task_id\"]] = {\"level\": int(r[\"Level\"]), \"gold\": r[\"Final answer\"],\n   22\t                           \"file\": str(DATA / fn) if fn else None,\n   23\t                           \"question\": r[\"Question\"]}\n   24\t\n   25\tresults = json.loads(OUT.read_text()) if OUT.exists() else []\n   26\tclean = {x[\"task_id\"]: x for x in results if \"HTTP 502\" not in x[\"got\"]}\n   27\t\n   28\tPROMPT_TMPL = (\n   29\t    \"You are answering one GAIA benchmark question.\\n\"\n   30\t    \"{file_note}\"\n   31\t    \"Use your websearch and webfetch tools to research facts, and bash/read tools for files.\\n\"\n   32\t    \"Think step by step and verify before concluding.\\n\"\n   33\t    \"IMPORTANT: your reply MUST end with a final line exactly of the form:\\n\"\n   34\t    \"ANSWER: <final answer only, as short as possible — no punctuation added, no unit unless asked>\\n\"\n   35\t    \"Never finish without that line.\\n\\n\"\n   36\t    \"Question: {q}\\n\"\n   37\t)\n   38\t\n   39\tdef extract(out):\n   40\t    lines = [l.strip() for l in out.splitlines() if l.strip()]\n   41\t    for line in reversed(lines):\n   42\t        if line.upper().startswith(\"ANSWER:\"):\n   43\t            return line[7:].strip().strip(\"*_`\").strip()\n   44\t    for line in reversed(lines):\n   45\t        low = line.lower()\n   46\t        if line and not low.startswith((\"╭\", \"│\", \"╰\", \"ask before edits\", \"ctrl+t\", \"esc to\")):\n   47\t            return line[:200]\n   48\t    return \"\"\n   49\t\n   50\tdef run_one(tid):\n   51\t    t = tasks[tid]\n   52\t    env = dict(os.environ)\n   53\t    env[\"GOATCODE_HOME\"] = str(HOME.resolve())\n   54\t    env[\"GOAT_MAX_STEPS\"] = \"25\"\n   55\t    file_note = f\"A data file for this question is at: {t['file']}\\n\" if t[\"file\"] else \"\"\n   56\t    prompt = PROMPT_TMPL.format(file_note=file_note, q=t[\"question\"])\n   57\t    t0 = time.time()\n   58\t    try:\n   59\t        r = subprocess.run([GOAT, \"-p\", prompt], capture_output=True, text=True,\n   60\t                           timeout=500, env=env, cwd=str(HERE), encoding=\"utf-8\", errors=\"replace\")\n   61\t        out = (r.stdout or \"\") + \"\\n\" + (r.stderr or \"\")\n   62\t    except subprocess.TimeoutExpired as e:\n   63\t        out = ((e.stdout or b\"\").decode(\"utf-8\", \"replace\") if isinstance(e.stdout, bytes) else (e.stdout or \"\")) + \"\\nTIMEOUT\"\n   64\t    return {\"task_id\": tid, \"level\": t[\"level\"], \"file\": bool(t[\"file\"]),\n   65\t            \"question\": t[\"question\"][:200], \"gold\": t[\"gold\"],\n   66\t            \"got\": extract(out), \"secs\": round(time.time() - t0, 1),\n   67\t            \"raw_tail\": out[-300:]}\n   68\t\n   69\t# warm up the shared flash server once\n   70\trun_one(next(iter(tasks)))  # throwaway? no — actually keep it:\n   71\tdef main():\n   72\t    # seed clean from existing non-502 results\n   73\t    global clean\n   74\t    clean = {x[\"task_id\"]: x for x in json.loads(OUT.read_text()) if \"HTTP 502\" not in x[\"got\"]}\n   75\t    print(f\"seeded clean: {len(clean)} / {len(tasks)}\", flush=True)\n   76\t    for rnd in range(1, ROUNDS + 1):\n   77\t        todo = [tid for tid in tasks if tid not in clean]\n   78\t        if not todo:\n   79\t            break\n   80\t        print(f\"=== ROUND {rnd}: {len(todo)} to go (K={K}) ===\", flush=True)\n   81\t        fails502 = 0\n   82\t        with ThreadPoolExecutor(max_workers=K) as ex:\n   83\t            futs = {ex.submit(run_one, tid): tid for tid in todo}\n   84\t            n = 0\n   85\t            for fut in as_completed(futs):\n   86\t                res = fut.result()\n   87\t                n += 1\n   88\t                if \"HTTP 502\" in res[\"got\"] or \"HTTP 502\" in res[\"raw_tail\"][-150:]:\n   89\t                    fails502 += 1\n   90\t                    tag = \"502\"\n   91\t                else:\n   92\t                    clean[res[\"task_id\"]] = res\n   93\t                    tag = \"OK \"\n   94\t                OUT.write_text(json.dumps(list(clean.values()), indent=1))\n   95\t                if tag == \"OK \":\n   96\t                    print(f\"  [{n}/{len(todo)}] {tag} L{res['level']} {res['task_id'][:8]} {res['secs']}s got={res['got'][:40]!r}\", flush=True)\n   97\t                elif n % 10 == 0:\n   98\t                    print(f\"  [{n}/{len(todo)}] ... {fails502} rate-limited so far\", flush=True)\n   99\t        left = len(tasks) - len(clean)\n  100\t        print(f\"round {rnd} done: {len(clean)}/{len(tasks)} answered, {left} rate-limited\", flush=True)\n  101\t        if left == 0:\n  102\t            break\n  103\t        wait = 60 if fails502 < len(todo) * 0.5 else 300\n  104\t        print(f\"  sleeping {wait}s before next round\", flush=True)\n  105\t        time.sleep(wait)\n  106\t    print(\"ALL_DONE\", len(clean), \"/\", len(tasks))\n  107\t\n  108\tif __name__ == \"__main__\":\n  109\t    main()\n  110\t","toolCallId":"call_71f5efbc539e4f749dc1fa76","name":"read"}
{"role":"tool","content":"    1\t# Grade GAIA full results with upstream question_scorer + order-insensitive list compare.\n    2\timport json, re, string, sys\n    3\tfrom collections import defaultdict\n    4\t\n    5\tdef normalize(s):\n    6\t    s = (s or \"\").lower().strip()\n    7\t    punc = string.punctuation.replace(\",\", \"\").replace(\"%\", \"\")\n    8\t    s = \"\".join(c for c in s if c not in punc)\n    9\t    return re.sub(r\"\\s+\", \" \", s).strip()\n   10\t\n   11\tdef num(s):\n   12\t    s = (s or \"\").strip().rstrip(\".\")\n   13\t    try:\n   14\t        if s.endswith(\"%\"):\n   15\t            return float(s[:-1].replace(\",\", \"\")) / 100\n   16\t        return float(s.replace(\",\", \"\"))\n   17\t    except Exception:\n   18\t        return None\n   19\t\n   20\tdef score_one(pred, gold):\n   21\t    p, g = str(pred or \"\"), str(gold or \"\")\n   22\t    # numeric\n   23\t    pn, gn = num(p), num(g)\n   24\t    if gn is not None and pn is not None and abs(pn - gn) < 1e-6:\n   25\t        return True\n   26\t    # normalized string\n   27\t    if normalize(p) == normalize(g) and normalize(g):\n   28\t        return True\n   29\t    # list compare (order-insensitive when elements are comparable)\n   30\t    if \",\" in g:\n   31\t        ge = [normalize(x) for x in g.split(\",\") if normalize(x)]\n   32\t        pe = [normalize(x) for x in p.split(\",\") if normalize(x)]\n   33\t        if ge and pe and sorted(ge) == sorted(pe):\n   34\t            return True\n   35\t    return False\n   36\t\n   37\tif __name__ == \"__main__\":\n   38\t    path = sys.argv[1] if len(sys.argv) > 1 else \"results_full.json\"\n   39\t    res = json.load(open(path, encoding=\"utf-8\"))\n   40\t    by_level = defaultdict(lambda: [0, 0])\n   41\t    for x in res:\n   42\t        ok = score_one(x[\"got\"], x[\"gold\"])\n   43\t        x[\"correct\"] = ok\n   44\t        L = x.get(\"level\", 1)\n   45\t        by_level[L][0] += ok\n   46\t        by_level[L][1] += 1\n   47\t    json.dump(res, open(path, \"w\"), indent=1)\n   48\t    tot_ok = sum(v[0] for v in by_level.values())\n   49\t    tot = sum(v[1] for v in by_level.values())\n   50\t    print(\"per level:\")\n   51\t    for L in sorted(by_level):\n   52\t        ok, n = by_level[L]\n   53\t        print(f\"  L{L}: {ok}/{n} = {100*ok/n:.1f}%\")\n   54\t    print(f\"OVERALL: {tot_ok}/{tot} = {100*tot_ok/tot:.1f}%\")\n   55\t    empty = sum(1 for x in res if not x[\"got\"].strip())\n   56\t    to = sum(1 for x in res if \"TIMEOUT\" in x.get(\"raw_tail\",\"\"))\n   57\t    print(f\"empty answers: {empty} | timeouts: {to}\")\n   58\t    print()\n   59\t    print(\"--- misses ---\")\n   60\t    for x in res:\n   61\t        if not x[\"correct\"]:\n   62\t            print(f\"L{x.get('level',1)} | {x['question'][:64]!r} got={x['got'][:36]!r} gold={str(x['gold'])[:36]!r}\")\n   63\t","toolCallId":"call_749d41fc621f4a2a8b299730","name":"read"}
