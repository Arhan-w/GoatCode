{"role":"tool","content":"    1\t# GAIA validation run for GoatCode (Goated-Flash-Free, zero-config).\r\n    2\t# Sample: N text-only Level-1 questions. Sequential with shared flash server.\r\n    3\timport json, subprocess, sys, time\r\n    4\tfrom pathlib import Path\r\n    5\t\r\n    6\tHERE = Path(__file__).parent\r\n    7\tN = int(sys.argv[1]) if len(sys.argv) > 1 else 10\r\n    8\tGOAT = str((HERE.parent / \"dist\" / \"goat.exe\").resolve())\r\n    9\tHOME = HERE / \".goathome\"\r\n   10\tOUT = HERE / \"results.json\"\r\n   11\t\r\n   12\trows = json.loads((HERE / \"all.json\").read_text())\r\n   13\t# text-only level 1, deterministic sample: first N by task_id sort\r\n   14\tqs = [r for r in rows if str(r[\"Level\"]) == \"1\" and not r.get(\"file_name\")]\r\n   15\tqs.sort(key=lambda r: r[\"task_id\"])\r\n   16\tqs = qs[:N]\r\n   17\tprint(f\"running {len(qs)} level-1 text-only questions\")\r\n   18\t\r\n   19\tPROMPT = (\"You are answering one GAIA benchmark question. Use your websearch and webfetch tools \"\r\n   20\t          \"to research. Think step by step. When certain, end your reply with a line exactly of the form:\\n\"\r\n   21\t          \"ANSWER: <final answer only, as short as possible>\\n\\nQuestion: {q}\\n\")\r\n   22\t\r\n   23\tresults = json.loads(OUT.read_text()) if OUT.exists() else []\r\n   24\tdone = {r[\"task_id\"] for r in results}\r\n   25\t\r\n   26\tfor i, q in enumerate(qs):\r\n   27\t    if q[\"task_id\"] in done:\r\n   28\t        continue\r\n   29\t    import os\r\n   30\t    env = dict(os.environ)\r\n   31\t    env[\"GOATCODE_HOME\"] = str(HOME.resolve())\r\n   32\t    (HERE / \"tmp\").mkdir(exist_ok=True)\r\n   33\t    HOME.mkdir(exist_ok=True)\r\n   34\t    t0 = time.time()\r\n   35\t    try:\r\n   36\t        r = subprocess.run([GOAT, \"-p\", PROMPT.format(q=q[\"Question\"])],\r\n   37\t                           capture_output=True, text=True, timeout=420, env=env,\r\n   38\t                           cwd=str(HERE), encoding=\"utf-8\", errors=\"replace\")\r\n   39\t        out = (r.stdout or \"\") + \"\\n\" + (r.stderr or \"\")\r\n   40\t    except subprocess.TimeoutExpired as e:\r\n   41\t        out = ((e.stdout or b\"\").decode(\"utf-8\", \"replace\") if isinstance(e.stdout, bytes) else (e.stdout or \"\")) + \"\\nTIMEOUT\"\r\n   42\t    elapsed = round(time.time() - t0, 1)\r\n   43\t    ans = \"\"\r\n   44\t    for line in reversed(out.splitlines()):\r\n   45\t        line = line.strip()\r\n   46\t        if line.upper().startswith(\"ANSWER:\"):\r\n   47\t            ans = line[7:].strip()\r\n   48\t            break\r\n   49\t    results.append({\"task_id\": q[\"task_id\"], \"question\": q[\"Question\"][:160],\r\n   50\t                    \"gold\": q[\"Final answer\"], \"got\": ans, \"secs\": elapsed,\r\n   51\t                    \"raw_tail\": out[-400:]})\r\n   52\t    OUT.write_text(json.dumps(results, indent=1))\r\n   53\t    print(f\"[{i+1}/{len(qs)}] {q['task_id'][:8]} {elapsed}s got={ans[:40]!r} gold={str(q['Final answer'])[:40]!r}\", flush=True)\r\n   54\t\r\n   55\tprint(\"DONE\", len(results))\r\n   56\t","toolCallId":"call_796819ca8d4c42138aab21d3","name":"read"}
{"role":"tool","content":"    1\t# Wait for upstream recovery, then finish GAIA with slow, gentle rounds; score + Telegram.\n    2\timport json, os, re, subprocess, sys, time\n    3\tfrom pathlib import Path\n    4\tfrom concurrent.futures import ThreadPoolExecutor, as_completed\n    5\t\n    6\tHERE = Path(__file__).parent\n    7\tGOAT = str((HERE.parent / \"dist\" / \"goat.exe\").resolve())\n    8\tHOME = HERE / \".goathome\"\n    9\tOUT = HERE / \"results_full.json\"\n   10\tDATA = HERE / \"data\"\n   11\tSKIP_EXT = {\".mp3\", \".wav\", \".m4a\"}\n   12\tJUNK = re.compile(r\"error: LLMError|HTTP 5\\d\\d|Unable to connect|socket conne|TIMEOUT|did not start|stopped after \\d+ steps|^\\[tool \", re.I)\n   13\t\n   14\trows = json.loads((HERE / \"all.json\").read_text())\n   15\ttasks = {}\n   16\tfor r in rows:\n   17\t    fn = r.get(\"file_name\")\n   18\t    if fn and (Path(fn).suffix.lower() in SKIP_EXT or not (DATA / fn).exists()):\n   19\t        continue\n   20\t    tasks[r[\"task_id\"]] = {\"level\": int(r[\"Level\"]), \"gold\": r[\"Final answer\"],\n   21\t                           \"file\": str(DATA / fn) if fn else None, \"question\": r[\"Question\"]}\n   22\t\n   23\tres = json.loads(OUT.read_text()) if OUT.exists() else []\n   24\tclean = {x[\"task_id\"]: x for x in res if not JUNK.search(x[\"got\"])}\n   25\tprint(f\"resume: {len(clean)}/{len(tasks)} clean\", flush=True)\n   26\t\n   27\tPROMPT_TMPL = (\n   28\t    \"You are answering one GAIA benchmark question.\\n{file_note}\"\n   29\t    \"Use your websearch and webfetch tools to research facts, and bash/read tools for files.\\n\"\n   30\t    \"Think step by step and verify before concluding.\\n\"\n   31\t    \"IMPORTANT: your reply MUST end with a final line exactly of the form:\\n\"\n   32\t    \"ANSWER: <final answer only, as short as possible>\\nNever finish without that line.\\n\\n\"\n   33\t    \"Question: {q}\\n\"\n   34\t)\n   35\t\n   36\tdef extract(out):\n   37\t    lines = [l.strip() for l in out.splitlines() if l.strip()]\n   38\t    for line in reversed(lines):\n   39\t        if line.upper().startswith(\"ANSWER:\"):\n   40\t            return line[7:].strip().strip(\"*_`\").strip()\n   41\t    for line in reversed(lines):\n   42\t        if line and not line.lower().startswith((\"╭\", \"│\", \"╰\", \"ask before edits\", \"ctrl+t\", \"esc to\")):\n   43\t            return line[:200]\n   44\t    return \"\"\n   45\t\n   46\tdef invoke(prompt):\n   47\t    env = dict(os.environ)\n   48\t    env[\"GOATCODE_HOME\"] = str(HOME.resolve())\n   49\t    env[\"GOAT_MAX_STEPS\"] = \"60\"\n   50\t    t0 = time.time()\n   51\t    to = 1200 if os.environ.get(\"GAIA_BIG\") else 500\n   52\t    try:\n   53\t        r = subprocess.run([GOAT, \"-p\", prompt], capture_output=True, text=True,\n   54\t                           timeout=to, env=env, cwd=str(HERE), encoding=\"utf-8\", errors=\"replace\")\n   55\t        out = (r.stdout or \"\") + \"\\n\" + (r.stderr or \"\")\n   56\t    except subprocess.TimeoutExpired as e:\n   57\t        out = ((e.stdout or b\"\").decode(\"utf-8\", \"replace\") if isinstance(e.stdout, bytes) else (e.stdout or \"\")) + \"\\nTIMEOUT\"\n   58\t    return extract(out), round(time.time() - t0, 1), out[-300:]\n   59\t\n   60\tdef healthy():\n   61\t    ans, secs, tail = invoke(\"Reply with exactly the word: UP\")\n   62\t    return ans.upper().startswith(\"UP\") and \"LLMError\" not in ans and \"502\" not in ans\n   63\t\n   64\tFAILS = HERE / \"fails.json\"\n   65\tdef failcount():\n   66\t    try: return json.load(open(FAILS))\n   67\t    except Exception: return {}\n   68\t\n   69\tdef run_task(tid):\n   70\t    t = tasks[tid]\n   71\t    file_note = f\"A data file for this question is at: {t['file']}\\n\" if t[\"file\"] else \"\"\n   72\t    ans, secs, tail = invoke(PROMPT_TMPL.format(file_note=file_note, q=t[\"question\"]))\n   73\t    return {\"task_id\": tid, \"level\": t[\"level\"], \"file\": bool(t[\"file\"]),\n   74\t            \"question\": t[\"question\"][:200], \"gold\": t[\"gold\"], \"got\": ans, \"secs\": secs, \"raw_tail\": tail}\n   75\t\n   76\tK = 4\n   77\twhile True:\n   78\t    fc = failcount()\n   79\t    # quarantine: 2+ failures -> stop retrying (record as EXCLUDED so count can finish)\n   80\t    for tid, n in list(fc.items()):\n   81\t        if n >= 2 and tid not in clean:\n   82\t            clean[tid] = {\"task_id\": tid, \"level\": tasks[tid][\"level\"], \"file\": bool(tasks[tid][\"file\"]),\n   83\t                          \"question\": tasks[tid][\"question\"][:200], \"gold\": tasks[tid][\"gold\"],\n   84\t                          \"got\": \"EXCLUDED: timed out after repeated attempts\", \"secs\": 0,\n   85\t                          \"raw_tail\": \"excluded\"}\n   86\t            OUT.write_text(json.dumps(list(clean.values()), indent=1))\n   87\t            print(\"EXCLUDED (2 fails):\", tid[:8], flush=True)\n   88\t    todo = [tid for tid in tasks if tid not in clean]\n   89\t    if not todo:\n   90\t        break\n   91\t    # health gate: wait until upstream serves us again\n   92\t    waits = 0\n   93\t    while not healthy():\n   94\t        waits += 1\n   95\t        print(f\"upstream unhealthy, wait 10min ({waits})\", flush=True)\n   96\t        time.sleep(600)\n   97\t    # big-timeout mode after first failures for the whole tail\n   98\t    import os as _os\n   99\t    fc = failcount()\n  100\t    if any(fc.get(t, 0) >= 1 for t in todo):\n  101\t        _os.environ[\"GAIA_BIG\"] = \"1\"\n  102\t        print(\"escalated timeouts: 1200s\", flush=True)\n  103\t    else:\n  104\t        _os.environ.pop(\"GAIA_BIG\", None)\n  105\t    print(f\"healthy. {len(todo)} to go, K={K}\", flush=True)\n  106\t    batch = todo[:8]\n  107\t    with ThreadPoolExecutor(max_workers=K) as ex:\n  108\t        futs = [ex.submit(run_task, tid) for tid in batch]\n  109\t        for fut in as_completed(futs):\n  110\t            r = fut.result()\n  111\t            if JUNK.search(r[\"got\"]):\n  112\t                fc = failcount(); fc[r[\"task_id\"]] = fc.get(r[\"task_id\"], 0) + 1\n  113\t                FAILS.write_text(json.dumps(fc))\n  114\t                print(\"  junk:\", r[\"task_id\"][:8], r[\"got\"][:40], flush=True)\n  115\t            else:\n  116\t                clean[r[\"task_id\"]] = r\n  117\t                OUT.write_text(json.dumps(list(clean.values()), indent=1))\n  118\t                print(f\"  OK L{r['level']} {r['task_id'][:8]} {r['secs']}s {r['got'][:40]!r}\", flush=True)\n  119\t            time.sleep(4)\n  120\t    print(f\"progress: {len(clean)}/{len(tasks)}\", flush=True)\n  121\t\n  122\tprint(\"ALL_CLEAN\", len(clean), \"/\", len(tasks), flush=True)\n  123\tsubprocess.run([sys.executable, str(HERE / \"send_results.py\")])\n  124\t","toolCallId":"call_c672debde0e94c31b0ed8dc7","name":"read"}
