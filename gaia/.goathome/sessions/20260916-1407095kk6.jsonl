n\\\": \\\"https://gemini.google.com\\\",\\r\\n  284\\t        \\\"Referer\\\": f\\\"https://gemini.google.com{prefix}/app\\\",\\r\\n  285\\t        \\\"X-Same-Domain\\\": \\\"1\\\",\\r\\n  286\\t        \\\"User-Agent\\\": \\\"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\\\",\\r\\n  287\\t    }\\r\\n  288\\t    if prefix:\\r\\n  289\\t        headers[\\\"X-Goog-AuthUser\\\"] = str(CONFIG[\\\"auth_user\\\"])\\r\\n  290\\t\\r\\n  291\\t    cookie_str, sapisid = load_cookie()\\r\\n  292\\t    if cookie_str:\\r\\n  293\\t        headers[\\\"Cookie\\\"] = cookie_str\\r\\n  294\\t    if sapisid:\\r\\n  295\\t        headers[\\\"Authorization\\\"] = make_sapisidhash(sapisid)\\r\\n  296\\t\\r\\n  297\\t    last_err = None\\r\\n  298\\t    for attempt in range(CONFIG[\\\"retry_attempts\\\"]):\\r\\n  299\\t        try:\\r\\n  300\\t            req = urllib.request.Request(url, data=body, headers=headers, method=\\\"POST\\\")\\r\\n  301\\t            ctx = ssl.create_default_context()\\r\\n  302\\t            proxy = CONFIG.get(\\\"proxy\\\")\\r\\n  303\\t            if proxy:\\r\\n  304\\t                opener = urllib.request.build_opener(\\r\\n  305\\t                    urllib.request.ProxyHandler({\\\"http\\\": proxy, \\\"https\\\": proxy}),\\r\\n  306\\t                    urllib.request.HTTPSHandler(context=ctx)\\r\\n  307\\t                )\\r\\n  308\\t                resp = opener.open(req, timeout=CONFIG[\\\"request_timeout_sec\\\"])\\r\\n  309\\t            else:\\r\\n  310\\t                resp = urllib.request.urlopen(req, context=ctx, timeout=CONFIG[\\\"request_timeout_sec\\\"])\\r\\n  311\\t            return resp.read().decode(\\\"utf-8\\\", errors=\\\"replace\\\")\\r\\n  312\\t        except urllib.error.HTTPError as e:\\r\\n  313\\t            if e.code == 405 and update_bl_if_needed():\\r\\n  314\\t                reqid = int(time.time()) % 1000000\\r\\n  315\\t                url = (\\r\\n  316\\t                    f\\\"https://gemini.